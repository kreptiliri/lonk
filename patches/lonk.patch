+/* One frame of stalking: each live stalker steps toward the player on the ground plane at the player's height and turns to
+   face them (yaw only; local Z = facing, as spawn_request reads it). A stalker whose name no longer reads back is dropped. */
+static void stalk_step(uint64_t frame, uintptr_t player) {
+    float target[3];
+    if (!read_mem(player + ACTOR_POS, target, sizeof target)) return;
+    for (unsigned i = 0; i < stalker_count;) {
+        uintptr_t actor = stalkers[i].actor, name = read_ptr(actor + GAME_ACTOR_NAME);
+        char text[64] = {0};
+        float pos[3];
+        if (!name || !read_mem(name, text, sizeof text - 1) || strcmp(text, stalkers[i].name) ||
+            !read_mem(actor + ACTOR_POS, pos, sizeof pos) || !valid_xyz(pos)) {
+            fprintf(stderr, "[survey] stalk: dropped %s (%#llx)\n", stalkers[i].name, (unsigned long long)actor);
+            stalkers[i] = stalkers[--stalker_count];
+            continue;
+        }
+        float dx = target[0] - pos[0], dz = target[2] - pos[2], dist = sqrtf(dx * dx + dz * dz);
+        if (dist < 0.01f) { ++i; continue; }
+        dx /= dist; dz /= dist;
+        float step = fminf(stalk_speed / 60.0f, fmaxf(dist - stalk_stop, 0.0f));
+        float matrix[12] = {dz, 0, dx, pos[0] + dx * step,
+                            0,  1, 0,  target[1],
+                            -dx, 0, dz, pos[2] + dz * step};
+        survey_force((void *)actor, matrix, 0);
+        if (!i && frame % 60 == 0) fprintf(stderr, "[survey] stalk: frame=%llu %s dist=%.2f\n", (unsigned long long)frame, stalkers[i].name, dist);
+        ++i;
+    }
+}
