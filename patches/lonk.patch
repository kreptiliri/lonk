+/* The terrain heightmap query behind the AI node QueryTerrainGetGroundHeight (main+0x272350c): T = [main+0x3add550],
+   scene = 0x2b7332c(T, pos, 1, 0, 300), 0x5db4c0(&height, xz, scene, -1, 0, 1, 0) answers 1 or 2. No buildings or sky islands. */
+static int terrain_height(float x, float z, float probe_y, float *out) {
+    static const uint32_t w_scene[] = {0xf0007b08, 0x9133c108, 0xf9400108, 0xb4000da8, 0xd10283ff};
+    static const uint32_t w_height[] = {0xb40055a2, 0xf940044b, 0xb400556b, 0xd10283ff, 0xa9057bfd};
+    static void *(*scene_fn)(void *, const float *, int, int, float);
+    static int (*height_fn)(float *, const float *, void *, int, int, int, int);
+    static int checked;
+    if (!checked) {
+        checked = 1;
+        scene_fn = (void *(*)(void *, const float *, int, int, float))game_fn(0x2b7332c, w_scene, 5);
+        height_fn = (int (*)(float *, const float *, void *, int, int, int, int))game_fn(0x5db4c0, w_height, 5);
+        fprintf(stderr, "[survey] terrain query: scene %s, height %s\n", scene_fn ? "ok" : "MISMATCH", height_fn ? "ok" : "MISMATCH");
+    }
+    void *t = (void *)read_ptr(survey_main + 0x3add550);
+    if (!scene_fn || !height_fn || !t) return 0;
+    float pos[3] = {x, probe_y, z}, xz[2] = {x, z}, h = NAN;
+    void *scene = scene_fn(t, pos, 1, 0, 300.0f);
+    if (!scene) return 0;
+    int r = height_fn(&h, xz, scene, -1, 0, 1, 0);
+    if ((r != 1 && r != 2) || !isfinite(h)) return 0;
+    *out = h;
+    return 1;
+}
+/* A physics raycast, set up the way the AI node QueryCheckCliffRayCast (0x260b30c) builds one on its stack: a 0x178-byte
+   query, vtable [main+0x395d990]+0x10, start at +0x08, end at +0x14, fraction -1 at +0x3c, a collision filter at +0x128
+   (vtable [main+0x3988178]+0x10, layers 0xfffcffff00000011) pointed to by +0x60; bool 0x1952a4(&query, 0) casts it and
+   leaves the hit position at +0x24. Unlike the terrain query it sees sky islands, buildings, bridges and rocks. */
+static uint64_t ray_layers = 0xfffcffff00000001ull;   /* the cliff-check node's filter minus bit 4, which also hits big invisible volumes (the Temple of Time hall has a 15 m one he climbed); "survey raylayers <hex>" tries others */
+static uint8_t *ray_last;
+static int ray_cast(const float start[3], const float end[3], float hit[3], float normal[3]) {
+    static const uint32_t w_cast[] = {0x39446008, 0x37184b08, 0xa9ba7bfd, 0xa9016ffc, 0x910003fd, 0xa90267fa};
+    static int checked, ok;
+    static bool (*cast)(void *, int);
+    if (!checked) {
+        checked = 1;
+        cast = (bool (*)(void *, int))game_fn(0x1952a4, w_cast, 6);
+        ok = cast && read_ptr(survey_main + 0x395d990) == survey_main + 0x361da10 && read_ptr(survey_main + 0x3988178) == survey_main + 0x3929490;
+        fprintf(stderr, "[survey] raycast: %s\n", ok ? "ok" : "MISMATCH");
+    }
+    if (!ok) return 0;
+    static _Alignas(16) uint8_t q[0x200];   /* static: "survey height" logs the last hit */
+    memset(q, 0, sizeof q);
+    uintptr_t vt = survey_main + 0x361da10 + 0x10, filter = (uintptr_t)(q + 0x128), filter_vt = survey_main + 0x3929490 + 0x10;
+    float fraction = -1;
+    uint32_t one = 1;
+    uint64_t layers = ray_layers, low = 0xffffffffull, all = ~0ull, one64 = 1;
+    memcpy(q, &vt, 8); memcpy(q + 0x08, start, 12); memcpy(q + 0x14, end, 12); memcpy(q + 0x3c, &fraction, 4);
+    memcpy(q + 0x60, &filter, 8); memcpy(q + 0x90, &one, 4); memcpy(q + 0x114, &one, 4);
+    memcpy(q + 0x128, &filter_vt, 8); memcpy(q + 0x130, &layers, 8); memcpy(q + 0x138, &low, 8); memcpy(q + 0x140, &all, 8);
+    memcpy(q + 0x150, &one64, 8);
+    ray_last = q;
+    if (!cast(q, 0)) return 0;
+    memcpy(hit, q + 0x24, 12);
+    if (normal) memcpy(normal, q + 0x30, 12);
+    for (int k = 0; k < 3; k++) if (!isfinite(hit[k])) return 0;
+    return 1;
+}
+/* The floor straight down from top to bottom, and how flat it is (up: the normal's y, 1 = flat, 0 = a wall) */
+static int ray_floor(float x, float z, float top, float bottom, float *out, float *up) {
+    float start[3] = {x, top, z}, end[3] = {x, bottom, z}, hit[3], normal[3];
+    /* a hit right at the start means the ray began inside something (a pillar, a mound): that's not a floor */
+    if (!ray_cast(start, end, hit, normal) || hit[1] > top - 0.02f || hit[1] < bottom - 0.01f) return 0;
+    float nl = sqrtf(normal[0] * normal[0] + normal[1] * normal[1] + normal[2] * normal[2]);
+    *out = hit[1];
+    if (up) *up = nl > 0.5f && nl < 1.5f ? normal[1] / nl : 1;
+    return 1;
+}
+static int ray_height(float x, float z, float top, float bottom, float *out) { return ray_floor(x, z, top, bottom, out, NULL); }
+/* Something in the way, knee high, within <reach> m along (dx, dz)? A walkable slope (normal pointing up) doesn't count. */
+static int ray_blocked(const float at[3], float dx, float dz, float reach) {
+    float start[3] = {at[0], at[1] + 0.6f, at[2]}, end[3] = {at[0] + dx * reach, at[1] + 0.6f, at[2] + dz * reach}, hit[3], normal[3];
+    if (!ray_cast(start, end, hit, normal)) return 0;
+    float nl = sqrtf(normal[0] * normal[0] + normal[1] * normal[1] + normal[2] * normal[2]);
+    return !(nl > 0.5f && nl < 1.5f && normal[1] / nl > 0.65f);
+}
+/* A ledge 0.8 m along (dx, dz): no floor from a step above his feet to 2.5 m below them (a wall too tall to step onto reads
+   the same, but the knee-high probe usually sees that first). */
+static int ray_ledge(const float at[3], float dx, float dz) {
+    float h;
+    return !ray_height(at[0] + dx * 0.8f, at[2] + dz * 0.8f, at[1] + 0.7f, at[1] - 2.5f, &h);
+}
+static int way_blocked(const float at[3], float dx, float dz) { return ray_blocked(at, dx, dz, 1.0f) || ray_ledge(at, dx, dz); }
+/* How far he can go from <at> along (dx, dz), up to <reach> m: until something knee high is in the way (a walkable slope
+   doesn't count) or there's no floor within a step above to 2.5 m below, checked every metre. */
+static float path_free(const float at[3], float dx, float dz, float reach) {
+    float start[3] = {at[0], at[1] + 0.6f, at[2]}, end[3] = {at[0] + dx * reach, at[1] + 0.6f, at[2] + dz * reach}, hit[3], normal[3];
+    float free = reach;
+    if (ray_cast(start, end, hit, normal)) {
+        float nl = sqrtf(normal[0] * normal[0] + normal[1] * normal[1] + normal[2] * normal[2]);
+        if (!(nl > 0.5f && nl < 1.5f && normal[1] / nl > 0.65f)) free = hypotf(hit[0] - at[0], hit[2] - at[2]);
+    }
+    float y = at[1], h;
+    for (float d = 1; d <= free; d += 1) {
+        if (!ray_height(at[0] + dx * d, at[2] + dz * d, y + 0.7f, y - 2.5f, &h)) return d - 1;
+        y = h;   /* follows the floor up and down a slope */
+    }
+    return free;
+}
+/* The clearest of <tries> directions: the first that's free for <want> m, else the one that goes furthest. Directions
+   are (base angle + offs[i]); returns the free length and the direction in out. */
+static float best_way(const float at[3], float base, const float *offs, int tries, float want, float out[2]) {
+    float best = -1;
+    for (int i = 0; i < tries; i++) {
+        float r = base + offs[i], dx = cosf(r), dz = sinf(r), f = path_free(at, dx, dz, want);
+        if (f > best) { best = f; out[0] = dx; out[1] = dz; }
+        if (f >= want) break;
+    }
+    return best;
+}
+/* Somewhere to put him next to the player (p, facing fx, fz): behind, then either side, then in front, 1.5 m away, wherever
+   there's flat floor about as high as the player's. Behind if none. */
+static void spot_near(const float p[3], float fx, float fz, float out[2]) {
+    static const float dirs[4][2] = {{-1, 0}, {0, 1}, {0, -1}, {1, 0}};   /* (forward, right) */
+    for (int i = 0; i < 4; i++) {
+        float x = p[0] + (fx * dirs[i][0] - fz * dirs[i][1]) * 1.5f, z = p[2] + (fz * dirs[i][0] + fx * dirs[i][1]) * 1.5f, h, up;
+        if (ray_floor(x, z, p[1] + 0.7f, p[1] - 1.0f, &h, &up) && up > 0.6f) { out[0] = x; out[1] = z; return; }
+    }
+    out[0] = p[0] - fx * 1.5f; out[1] = p[2] - fz * 1.5f;
+}
+/* PouchPlayer, spawned by us, stays invisible: the pause menu normally binds its model to the UI model scene and switches its
+   view masks. getModel 0xba8854, model+0x60 = its model scene, bindScene 0x585d58(model, scene), 0x50138c(model, mask) sets
+   every draw instance's view mask (instances: min(u32 model+0x10, u16 model+0x248) at [model+0x18], mask at inst+8).
+   The world scene is read from the player's own model. Logs before and after. */
+/* "survey peek <base> <off>... <bytes>": base is pouch, pmodel (its model), player, plmodel, main or a hex address; every
+   offset but the last is followed as a pointer (addr = [addr+off]), then <bytes> (<= 256) at addr+last are logged as words
+   and floats. Read-only. */
+/* "survey peek bones <base>": looks for his skeleton's world matrices. Follows pointers from <base> (pmodel) three deep,
+   0x800 bytes each, and logs every buffer holding 20+ 3x4 matrices in a row (rotation rows about unit length) whose
+   translations are within 3 m of his actor position. Found: [[model+0x458]+8], 97 column matrices whose forward offset
+   adds up the distance he's walked (never resets), and [[[model+0x3b8]+0x540]+0x80], 89 that don't move (bind pose). */
+static unsigned bones_count(uintptr_t at, const float pos[3]) {
+    /* row-major 3x4 (translation at 3, 7, 11) or 4x3 columns (9, 10, 11); in the world (near pos) or in the model (near 0) */
+    static const int tx[2][3] = {{3, 7, 11}, {9, 10, 11}};
+    unsigned best = 0;
+    for (int layout = 0; layout < 2; layout++) for (int world = 0; world < 2; world++) {
+        float m[12];
+        unsigned k = 0;
+        for (; k < 256 && read_mem(at + k * 0x30, m, sizeof m); k++) {
+            float r0 = m[0] * m[0] + m[1] * m[1] + m[2] * m[2];
+            const int *t = tx[layout];
+            float ox = world ? pos[0] : 0, oy = world ? pos[1] : 0, oz = world ? pos[2] : 0;
+            if (!(fabsf(r0 - 1) < 0.1f && fabsf(m[t[0]] - ox) < 3 && fabsf(m[t[1]] - oy) < 3 && fabsf(m[t[2]] - oz) < 3)) break;
+            if (!world && fabsf(m[t[0]]) + fabsf(m[t[1]]) + fabsf(m[t[2]]) < 1e-4f && k > 2) break;   /* not all identities */
+        }
+        if (k > best) best = k | (unsigned)(layout << 16) | (unsigned)(world << 17);
+    }
+    return best;
+}
+static void bones_scan(uintptr_t base, const float pos[3], int depth, char *path, size_t len) {
+    uint64_t words[0x100];
+    if (!read_mem(base, words, sizeof words)) return;
+    for (unsigned i = 0; i < 0x100; i++) {
+        uintptr_t q = (uintptr_t)words[i];
+        if (q < 0x100000000ull || q > 0x7fffffffffffull || (q & 7)) continue;
+        size_t at = strlen(path);
+        snprintf(path + at, len - at, " %x", i * 8);
+        unsigned n = bones_count(q, pos);
+        if ((n & 0xffff) >= 20) fprintf(stderr, "[survey] bones:%s -> %#llx: %u matrices (%s, %s)\n", path, (unsigned long long)q, n & 0xffff,
+                                        n >> 16 & 1 ? "columns" : "rows", n >> 17 & 1 ? "world" : "model");
+        else if (depth > 1) bones_scan(q, pos, depth - 1, path, len);
+        path[at] = 0;
+    }
+}
+static void eu_scan(uintptr_t eu);
+static uintptr_t pouch_eu(uintptr_t actor);
+static void peek_run(uintptr_t player) {
+    static const uint32_t w_model[] = {0xf9411408, 0xb4000168, 0xf9400500, 0xb4000100, 0xf9400008};
+    uintptr_t (*get_model)(uintptr_t) = (uintptr_t (*)(uintptr_t))game_fn(0xba8854, w_model, 5);
+    char buf[256], *save = NULL, *tok[24];
+    int n = 0;
+    snprintf(buf, sizeof buf, "%s", peek_request);
+    for (char *t = strtok_r(buf, " \t\r\n", &save); t && n < 24; t = strtok_r(NULL, " \t\r\n", &save)) tok[n++] = t;
+    const char *dump = NULL;   /* "survey peek dump <file> <base> <off>... <bytes>": up to 4 MB written raw to <file> */
+    int poke = 0;              /* "survey peek poke <base> <off>... <hex u32>": writes one word instead (debugging) */
+    if (n > 0 && !strcmp(tok[0], "poke")) {
+        poke = 1;
+        for (int i = 1; i < n; i++) tok[i - 1] = tok[i];
+        n -= 1;
+    }
+    if (n > 0 && !strcmp(tok[0], "dump")) {
+        if (n < 2) { fprintf(stderr, "[survey] peek dump: expected a file\n"); return; }
+        dump = tok[1];
+        for (int i = 2; i < n; i++) tok[i - 2] = tok[i];
+        n -= 2;
+    }
+    uintptr_t pouch = 0, addr = 0;
+    for (unsigned i = 0; i < stalker_count; i++) if (!strcmp(stalkers[i].name, "PouchPlayer")) pouch = stalkers[i].actor;
+    if (n == 1 && !strcmp(tok[0], "euscan")) { eu_scan(pouch ? pouch_eu(pouch) : 0); return; }
+    if (n == 2 && !strcmp(tok[0], "bones")) {
+        uintptr_t who = !strcmp(tok[1], "player") ? player : pouch, model = who && get_model ? get_model(who) : 0;
+        float pos[3];
+        char path[128] = "";
+        if (!model || !read_mem(who + ACTOR_POS, pos, sizeof pos)) { fprintf(stderr, "[survey] bones: no model\n"); return; }
+        fprintf(stderr, "[survey] bones: model %#llx at %.2f,%.2f,%.2f\n", (unsigned long long)model, pos[0], pos[1], pos[2]);
+        bones_scan(model, pos, 3, path, sizeof path);
+        return;
+    }
+    if (n < 3) { fprintf(stderr, "[survey] peek: expected <base> <off>... <bytes>\n"); return; }
+    if (!strcmp(tok[0], "pouch")) addr = pouch;
+    else if (!strcmp(tok[0], "pmodel")) addr = pouch && get_model ? get_model(pouch) : 0;
+    else if (!strcmp(tok[0], "player")) addr = player;
+    else if (!strcmp(tok[0], "plmodel")) addr = get_model ? get_model(player) : 0;
+    else if (!strcmp(tok[0], "main")) addr = survey_main;
+    else addr = (uintptr_t)strtoull(tok[0], NULL, 16);
+    for (int i = 1; i < n - 2 && addr; i++) addr = read_ptr(addr + (uintptr_t)strtoull(tok[i], NULL, 16));
+    if (addr) addr += (uintptr_t)strtoull(tok[n - 2], NULL, 16);
+    if (poke) {
+        uint32_t value = (uint32_t)strtoul(tok[n - 1], NULL, 16), was = 0;
+        if (!addr || !read_mem(addr, &was, 4)) { fprintf(stderr, "[survey] poke: unreadable (addr %#llx)\n", (unsigned long long)addr); return; }
+        memcpy((void *)addr, &value, 4);
+        fprintf(stderr, "[survey] poke %#llx: %08x -> %08x\n", (unsigned long long)addr, was, value);
+        return;
+    }
+    unsigned bytes = (unsigned)strtoul(tok[n - 1], NULL, 0);
+    if (dump) {
+        static uint8_t chunk[65536];
+        unsigned total = bytes > (4u << 20) ? 4u << 20 : bytes, done = 0;
+        FILE *f = addr ? fopen(dump, "wb") : NULL;
+        while (f && done < total) {
+            unsigned len = total - done > sizeof chunk ? (unsigned)sizeof chunk : total - done;
+            if (!read_mem(addr + done, chunk, len)) break;
+            fwrite(chunk, 1, len, f); done += len;
+        }
+        if (f) fclose(f);
+        fprintf(stderr, "[survey] peek dump %s: %u of %u bytes from %#llx\n", dump, done, total, (unsigned long long)addr);
+        return;
+    }
+    if (bytes > 256) bytes = 256;
+    bytes &= ~3u;
+    uint32_t w[64] = {0};
+    if (!addr || !bytes || !read_mem(addr, w, bytes)) { fprintf(stderr, "[survey] peek %s: unreadable (addr %#llx)\n", peek_request, (unsigned long long)addr); return; }
+    fprintf(stderr, "[survey] peek %s @ %#llx\n", peek_request, (unsigned long long)addr);
+    for (unsigned i = 0; i < bytes / 4; i += 4) {
+        char line[200]; size_t len = (size_t)snprintf(line, sizeof line, "[survey]   +%03x:", i * 4);
+        for (unsigned k = i; k < i + 4 && k < bytes / 4; k++) { float f; memcpy(&f, &w[k], 4); len += (size_t)snprintf(line + len, sizeof line - len, " %08x(%g)", w[k], f); }
+        fprintf(stderr, "%s\n", line);
+    }
+}
+/* An actor's animation state: as = [[[[actor+0x228]+0x40]+0x18]+0x18], 0 if any step is null. u32 as+0x130 state,
+   u32 as+0x18 slots (pointers 0x48 apart at [as+0x20]), a slot's command name at [slot+0x10], its rate at slot+0xd0.
+   PouchPlayer's slot 0 is the face, 1 the body, 2 the skin colour. */
+static uintptr_t anim_state(uintptr_t actor) {
+    uintptr_t p = actor;
+    static const unsigned offs[] = {0x228, 0x40, 0x18, 0x18};
+    for (unsigned i = 0; i < 4 && p; i++) p = read_ptr(p + offs[i]);
+    return p;
+}
+static void anim_log(const char *who, uintptr_t actor) {
+    uintptr_t as = anim_state(actor);
+    uint32_t a24 = 0, a28 = 0; read_mem(actor + 0x24, &a24, 4); read_mem(actor + 0x28, &a28, 4);
+    if (!as) { fprintf(stderr, "[survey] anim %s: actor=%#llx +24=%u +28=%#x no animation state\n", who, (unsigned long long)actor, a24, a28); return; }
+    uint32_t state = 0, slots = 0; read_mem(as + 0x130, &state, 4); read_mem(as + 0x18, &slots, 4);
+    uintptr_t slot0 = read_ptr(read_ptr(as + 0x20));
+    char cmd[64] = {0}; float rate = NAN;
+    if (slot0) { read_mem(read_ptr(slot0 + 0x10), cmd, sizeof cmd - 1); read_mem(slot0 + 0xd0, &rate, 4); }
+    fprintf(stderr, "[survey] anim %s: actor=%#llx +24=%u +28=%#x as=%#llx state=%u slots=%u slot0=%#llx cmd=\"%s\" rate=%g\n", who,
+            (unsigned long long)actor, a24, a28, (unsigned long long)as, state, slots, (unsigned long long)slot0, cmd, rate);
+}
+/* Start an animation command the way the game's own C++ callers do (0x1876efc, 0x1bc8dec): bool 0x4dc628(&req, 0). */
+static int pouch_anim(const char *name) {
+    static const uint32_t w_play[] = {0xd10683ff, 0xa9157bfd, 0xf900b3fc, 0xa9175ff8, 0xa91857f6, 0xa9194ff4};
+    bool (*play)(void *, int) = (bool (*)(void *, int))game_fn(0x4dc628, w_play, 6);
+    if (!play) { fprintf(stderr, "[survey] pouchanim: function mismatch\n"); return 0; }
+    int started = 0;
+    static char held[64];   /* the game may keep the name pointer */
+    snprintf(held, sizeof held, "%s", name);
+    for (unsigned i = 0; i < stalker_count; i++) {
+        if (strcmp(stalkers[i].name, "PouchPlayer")) continue;
+        uintptr_t actor = stalkers[i].actor;
+        anim_log("pouch before", actor);
+        if (!anim_state(actor)) { fprintf(stderr, "[survey] pouchanim: no animation chain, not calling\n"); continue; }
+        struct { uintptr_t actor; const char *name; uint32_t zero; float rate, a, b; uint8_t on, f21, f22, pad[5]; void *tail; } req;
+        _Static_assert(sizeof req == 0x30, "animation request is 0x30 bytes");
+        memset(&req, 0, sizeof req);
+        req.actor = actor; req.name = held; req.rate = 1.0f; req.a = req.b = -1.0f; req.on = 1;
+        bool ok = play(&req, 0);
+        fprintf(stderr, "[survey] pouchanim: %s -> %d\n", held, ok);
+        anim_log("pouch after", actor);
+        started += ok;
+    }
+    return started;
+}
+/* PouchPlayer's only full-body command is the menu's PauseMenuWait, an idle that picks Nml_Cold_Wait, Nml_Wait or
+   Nml_Hot_Wait from the ASB blackboard float "Temperature" (<0, 0, >0) on every update. Lonk's RomFS mod (lonk/mod) points
+   the cold and hot idles at Nml_Move_Walk and Nml_Move_Run, so the temperature becomes his gait. The blackboard is
+   [as+0x40]; its vtable+0x38 sets a float by name, the way ExecutePouchPlayerSetASBBParameter (0x241cc08) does. */
+enum { GAIT_IDLE, GAIT_WALK, GAIT_RUN, GAIT_DASH, GAIT_PARTY, GAIT_LOOK, GAIT_SURPRISE, GAIT_EAT, GAIT_MEAL, GAIT_YUCK, GAIT_JUMP,
+       GAIT_DRINK, GAIT_SULK, GAIT_LOOKUP, GAITS };
+static const char *const gait_names[GAITS] = {"idle", "walk", "run", "dash", "party", "look around", "surprise", "eat", "meal", "yuck",
+                                              "jump", "drink", "sulk", "look up"};
+static void pouch_gait(int gait, float speed) {
+    /* PauseMenuWait starts with a selector on the int HoldAnimationType; the mod points its cases 1 to 5 at the walk, run,
+       dash, the cooking "great meal" celebration (his party) and a startle; 0 is the plain idle, which shivers, sweats or
+       pants by itself where you are. Only that int: the game sets Temperature and Stamina every frame from where you are
+       (the menu's ExecutePouchPlayerSetASBBParameter), and fighting it restarted his walk every few steps. Looking around
+       has no case left, so he just stands. Each move clip plays at the rate that matches his speed (the clips' own speeds
+       are estimates), so his feet don't slide. Blackboard setters by name: int +0x30, float +0x38, bool +0x40. */
+    static const float clip_speed[] = {1, 1.6f, 4.2f, 6.5f};
+    /* case 1 is the UseItem tree, where the blackboard string picks the clip (the mod renamed some: look, jump, sulk, look up) */
+    static const int hold[GAITS] = {0, 0, 2, 3, 4, 1, 5, 1, 1, 1, 1, 1, 1, 1};
+    static const char *const use_item[GAITS] = {[GAIT_LOOK] = "EatCookingSkewer", [GAIT_EAT] = "EatFood", [GAIT_MEAL] = "EatCookingDish",
+        [GAIT_YUCK] = "EatBizarre", [GAIT_JUMP] = "EatTooHard", [GAIT_DRINK] = "Drink", [GAIT_SULK] = "UseFairy", [GAIT_LOOKUP] = "UseEnergyMaterial"};
+    struct { const char *name; uint64_t zero; } h_key = {"HoldAnimationType", 0}, u_key = {"UseItem", 0};
+    /* that tree only reads the string when it starts: from one of its emotes to another, a frame of idle in between */
+    int hop = gait != lonk_gait && lonk_gait >= 0 && use_item[gait] && use_item[lonk_gait];
+    int waiting = 0;
+    for (unsigned i = 0; i < stalker_count; i++) {
+        if (strcmp(stalkers[i].name, "PouchPlayer")) continue;
+        uintptr_t as = anim_state(stalkers[i].actor), bb = as ? read_ptr(as + 0x40) : 0, vt = bb ? read_ptr(bb) : 0;
+        uintptr_t set_int = vt ? read_ptr(vt + 0x30) : 0, set_float = vt ? read_ptr(vt + 0x38) : 0, set_bool = vt ? read_ptr(vt + 0x40) : 0;
+        uintptr_t set_string = vt ? read_ptr(vt + 0x28) : 0;   /* the menu's node sets "Arrow" through it */
+        int ok = 1;
+        uintptr_t setters[4] = {set_int, set_float, set_bool, set_string};
+        for (int k = 0; k < 4; k++) if (setters[k] < survey_main || setters[k] >= survey_main + 0x2bb9c00) ok = 0;
+        if (!ok) {
+            if (gait != lonk_gait) fprintf(stderr, "[survey] gait: no blackboard setter (as=%#llx)\n", (unsigned long long)as);
+            continue;
+        }
+        /* the mod's selector keeps the loop phase when he switches (run and sprint flow into each other), so an emote
+           would start where his loop is: it waits (a moment) for the loop to come round */
+        if (gait != lonk_gait && gait >= GAIT_PARTY && !hop && lonk_body) {
+            float phase = 0;
+            read_mem(lonk_body + 0x1e0, &phase, sizeof phase);
+            if (phase > 0.06f) { waiting = 1; continue; }
+        }
+        if (use_item[gait] && !hop) ((void (*)(uintptr_t, const void *, const char *))set_string)(bb, &u_key, use_item[gait]);
+        ((void (*)(uintptr_t, const void *, int))set_int)(bb, &h_key, hop ? 0 : hold[gait]);
+        if (gait != lonk_gait && !hop) fprintf(stderr, "[survey] gait: %s\n", gait_names[gait]);
+        /* the game puts each command in its own slot (0 face, 1 body, 2 skin colour here): find the one playing PauseMenuWait */
+        uint32_t slots = 0;
+        read_mem(as + 0x18, &slots, 4);
+        uintptr_t body = 0, table = read_ptr(as + 0x20);
+        for (uint32_t k = 0; k < slots && k < 8 && table && !body; k++) {
+            uintptr_t slot = read_ptr(table + k * 0x48);
+            char cmd[16] = {0};
+            if (slot && read_mem(read_ptr(slot + 0x10), cmd, sizeof cmd - 1) && !strcmp(cmd, "PauseMenuWait")) body = slot;
+        }
+        /* the rate that makes his steps match the ground he covers: lonk_root metres per loop, and the loop position
+           moves k per frame per unit of rate (measured as he goes, per gait), so rate = speed / (60 * metres * k) */
+        static float k_loop[4] = {0, 1 / 40.0f, 1 / 40.0f, 1 / 40.0f}, last_loop = -1, last_rate;
+        static int last_gait = -1;
+        float loop = -1;
+        if (body) read_mem(body + 0x1e0, &loop, sizeof loop);
+        if (gait >= GAIT_WALK && gait <= GAIT_DASH && gait == last_gait && last_rate > 0 && loop > last_loop && loop - last_loop < 0.2f)
+            k_loop[gait] += ((loop - last_loop) / last_rate - k_loop[gait]) * 0.05f;
+        float rate = 1.0f;
+        if (gait >= GAIT_WALK && gait <= GAIT_DASH)
+            rate = lonk_root[gait] > 0.1f && k_loop[gait] > 0 ? speed / (60 * lonk_root[gait] * k_loop[gait]) : speed / clip_speed[gait];
+        rate = gait < GAIT_WALK || gait > GAIT_DASH ? 1.0f : fminf(fmaxf(rate, 0.4f), 2.5f);
+        if (body) memcpy((void *)(body + 0xd0), &rate, sizeof rate);
+        last_loop = loop; last_rate = rate; last_gait = gait;
+        lonk_body = body;
+    }
+    if (!waiting) lonk_gait = hop ? GAIT_IDLE : gait;
+}
+/* Place PouchPlayer with the game's own set-transform, as the menu does: 0x2ba758(actor, &arg, 0); arg = position, row-major
+   rotation, scale, 8 zero bytes at +0x40, flags 7 at +0x48. Facing the player, where it already stands. */
+static void pouch_place(uintptr_t player) {
+    static const uint32_t w_set[] = {0xaa0103e8, 0x52800029, 0x1ac22121, 0xaa0803e2, 0x141c6b2b, 0x39408008};
+    void (*set_transform)(uintptr_t, void *, int) = (void (*)(uintptr_t, void *, int))game_fn(0x2ba758, w_set, 6);
+    if (!set_transform) { fprintf(stderr, "[survey] pouchplace: function mismatch\n"); return; }
+    float pp[3] = {0};
+    read_mem(player + ACTOR_POS, pp, sizeof pp);
+    for (unsigned i = 0; i < stalker_count; i++) {
+        if (strcmp(stalkers[i].name, "PouchPlayer")) continue;
+        float pos[3];
+        if (!read_mem(stalkers[i].actor + ACTOR_POS, pos, sizeof pos)) continue;
+        float hx = pp[0] - pos[0], hz = pp[2] - pos[2], hl = hypotf(hx, hz);
+        if (hl < 0.01f) { hx = 0; hz = 1; hl = 1; }
+        hx /= hl; hz /= hl;
+        struct { float pos[3], rot[9], scale[3]; uint8_t pad3c[4], zero40[8]; uint8_t flags; uint8_t pad[7]; } arg;
+        _Static_assert(sizeof arg == 0x50, "set-transform argument is 0x50 bytes");
+        memset(&arg, 0, sizeof arg);
+        memcpy(arg.pos, pos, sizeof pos);
+        float rot[9] = {hz, 0, hx, 0, 1, 0, -hx, 0, hz};
+        memcpy(arg.rot, rot, sizeof rot);
+        arg.scale[0] = arg.scale[1] = arg.scale[2] = 1; arg.flags = 7;
+        set_transform(stalkers[i].actor, &arg, 0);
+        fprintf(stderr, "[survey] pouchplace: set at %.2f,%.2f,%.2f\n", pos[0], pos[1], pos[2]);
+    }
+}
+static void pouch_show(uintptr_t player) {
+    static const uint32_t w_model[] = {0xf9411408, 0xb4000168, 0xf9400500, 0xb4000100, 0xf9400008};
+    static const uint32_t w_bind[] = {0xaa0003e8, 0xf9403000, 0xf100001f, 0xfa411004, 0x54000081};
+    static const uint32_t w_mask[] = {0x79449008, 0xb9401009, 0x6b08013f, 0x1a883128, 0x34000168};
+    uintptr_t (*get_model)(uintptr_t) = (uintptr_t (*)(uintptr_t))game_fn(0xba8854, w_model, 5);
+    void (*bind)(uintptr_t, uintptr_t) = (void (*)(uintptr_t, uintptr_t))game_fn(0x585d58, w_bind, 5);
+    void (*set_mask)(uintptr_t, uint32_t) = (void (*)(uintptr_t, uint32_t))game_fn(0x50138c, w_mask, 5);
+    if (!get_model || !bind || !set_mask) {
+        fprintf(stderr, "[survey] pouch: function mismatch model=%d bind=%d mask=%d\n", !!get_model, !!bind, !!set_mask); return;
+    }
+    uintptr_t world_model = get_model(player), world = world_model ? read_ptr(world_model + 0x60) : 0;
+    uintptr_t table = read_ptr(survey_main + 0x3adade8), entries = table ? read_ptr(table + 0x48) : 0;
+    fprintf(stderr, "[survey] pouch: player model=%#llx scene=%#llx | table entry0=%#llx [entry0]=%#llx entry1=%#llx [entry1]=%#llx\n",
+            (unsigned long long)world_model, (unsigned long long)world, (unsigned long long)entries, (unsigned long long)read_ptr(entries),
+            (unsigned long long)(entries + 0x60), (unsigned long long)read_ptr(entries + 0x60));
+    int found = 0;
+    for (unsigned i = 0; i < stalker_count; i++) {
+        if (strcmp(stalkers[i].name, "PouchPlayer")) continue;
+        found = 1;
+        uintptr_t model = get_model(stalkers[i].actor);
+        if (!model) { fprintf(stderr, "[survey] pouch: actor %#llx has no model\n", (unsigned long long)stalkers[i].actor); continue; }
+        for (int pass = 0; pass < 2; pass++) {
+            uint32_t n = 0; uint16_t n2 = 0;
+            read_mem(model + 0x10, &n, 4); read_mem(model + 0x248, &n2, 2);
+            if (n2 < n) n = n2;
+            uintptr_t arr = read_ptr(model + 0x18);
+            char masks[256] = {0}; size_t len = 0;
+            for (uint32_t k = 0; k < n && k < 24; k++) {
+                uint32_t mask = 0; read_mem(read_ptr(arr + k * 0x38) + 8, &mask, 4);
+                len += (size_t)snprintf(masks + len, sizeof masks - len, " %x", mask);
+                if (len >= sizeof masks) break;
+            }
+            fprintf(stderr, "[survey] pouch: %s model=%#llx scene=%#llx instances=%u masks:%s\n", pass ? "after" : "before",
+                    (unsigned long long)model, (unsigned long long)read_ptr(model + 0x60), n, masks);
+            if (pass) break;
+            if (world && read_ptr(model + 0x60) != world) bind(model, world);
+            set_mask(model, 0xffffffffu);
+        }
+    }
+    if (!found) fprintf(stderr, "[survey] pouch: no spawned PouchPlayer (survey spawn <tag> PouchPlayer first)\n");
+}
+/* "survey drop <name prefix|all>": body pieces leave Lonk. There's no delete yet, so each one is hidden (view mask 0) and put
+   50 m under where it stands, out of the player's reach and interaction search. */
+static void drop_run(void) {
+    static const uint32_t w_model[] = {0xf9411408, 0xb4000168, 0xf9400500, 0xb4000100, 0xf9400008};
+    static const uint32_t w_mask[] = {0x79449008, 0xb9401009, 0x6b08013f, 0x1a883128, 0x34000168};
+    uintptr_t (*get_model)(uintptr_t) = (uintptr_t (*)(uintptr_t))game_fn(0xba8854, w_model, 5);
+    void (*set_mask)(uintptr_t, uint32_t) = (void (*)(uintptr_t, uint32_t))game_fn(0x50138c, w_mask, 5);
+    int all = !strcmp(drop_request, "all");
+    size_t len = strlen(drop_request);
+    unsigned dropped = 0;
+    for (unsigned i = 0; i < stalker_count;) {
+        if (!all && strncmp(stalkers[i].name, drop_request, len)) { ++i; continue; }
+        uintptr_t actor = stalkers[i].actor, name = read_ptr(actor + GAME_ACTOR_NAME);
+        char text[64] = {0};
+        float pos[3];
+        int live = name && read_mem(name, text, sizeof text - 1) && !strcmp(text, stalkers[i].name);   /* gone already: just forget it */
+        uintptr_t model = live && get_model && set_mask ? get_model(actor) : 0;
+        if (model) set_mask(model, 0);
+        if (live && read_mem(actor + ACTOR_POS, pos, sizeof pos) && valid_xyz(pos)) {
+            float matrix[12] = {1, 0, 0, pos[0], 0, 1, 0, pos[1] - 50, 0, 0, 1, pos[2]};
+            survey_force((void *)actor, matrix, 0);
+        }
+        fprintf(stderr, "[survey] drop: %s (%#llx) live=%d hidden=%d\n", stalkers[i].name, (unsigned long long)actor, live, model != 0);
+        stalkers[i] = stalkers[--stalker_count];
+        dropped++;
+    }
+    if (!dropped) fprintf(stderr, "[survey] drop: nothing named %s*\n", drop_request);
+    if (!stalker_count) lonk_anchored = 0;
+}
+/* Dressing PouchPlayer the way the pause menu's OneShotChangeEquipmentForPouch does: eu = 0xcbffa0(actor) (its EquipmentUser,
+   [[actor+0x228]+0x230]), then equip 0x1b6cd78(eu, slot, &name, dye -1, 0, 0) per slot. An empty name dresses like the player
+   (or hair + default clothes when the player wears none). The real Player gets its Zonai arm the same way: slot 19 (Extra),
+   "PlayerRaulHand". The pieces spawn asynchronously; isAllCreated 0x1b7be9c(eu) turns nonzero when they're all in. */
+static uintptr_t pouch_eu(uintptr_t actor) {
+    static const uint32_t w_eu[] = {0xf9411408, 0xb4000068, 0xf9411900, 0xd65f03c0};
+    uintptr_t (*get_eu)(uintptr_t) = (uintptr_t (*)(uintptr_t))game_fn(0xcbffa0, w_eu, 4);
+    return get_eu ? get_eu(actor) : 0;
+}
+static unsigned dress_show(uintptr_t eu, uintptr_t world, bool quiet);
+static void dress_log(const char *when, uintptr_t player) {
+    static const uint32_t w_done[] = {0x52887508, 0x8b080008, 0xb9400109, 0x7100053f, 0x54000500, 0xb9400909};
+    uint32_t (*all_created)(uintptr_t) = (uint32_t (*)(uintptr_t))game_fn(0x1b7be9c, w_done, 6);
+    for (unsigned i = 0; i < stalker_count; i++) {
+        if (strcmp(stalkers[i].name, "PouchPlayer")) continue;
+        uintptr_t eu = pouch_eu(stalkers[i].actor);
+        if (!eu) { fprintf(stderr, "[survey] dress %s: no equipment user\n", when); continue; }
+        uint32_t state[20] = {0};
+        for (unsigned s = 0; s < 20; s++) read_mem(eu + 0x43a8 + s * 8, &state[s], 4);
+        uint64_t link[3][3] = {{0}};
+        for (unsigned s = 9; s < 12; s++) read_mem(eu + 0xe0 + (s - 9) * 0x18, link[s - 9], 0x18);
+        fprintf(stderr, "[survey] dress %s: eu=%#llx all_created=%u creating 9/10/11/19=%u/%u/%u/%u links 9=%llx,%llx 10=%llx,%llx 11=%llx,%llx\n", when,
+                (unsigned long long)eu, all_created ? all_created(eu) : 0xffffffffu, state[9], state[10], state[11], state[19],
+                (unsigned long long)link[0][1], (unsigned long long)link[0][2], (unsigned long long)link[1][1], (unsigned long long)link[1][2],
+                (unsigned long long)link[2][1], (unsigned long long)link[2][2]);
+        if (all_created && all_created(eu)) {   /* again every check: a piece's model can arrive after the piece (real armor loads first) */
+            static const uint32_t w_model[] = {0xf9411408, 0xb4000168, 0xf9400500, 0xb4000100, 0xf9400008};
+            uintptr_t (*get_model)(uintptr_t) = (uintptr_t (*)(uintptr_t))game_fn(0xba8854, w_model, 5);
+            uintptr_t world_model = get_model ? get_model(player) : 0;
+            dress_show(eu, world_model ? read_ptr(world_model + 0x60) : 0, false);
+        }
+    }
+}
+/* Every frame once he's dressed: the game keeps putting his pieces back in the menu's scene (that's the flashing, then no legs), so they
+   go back to the world scene each frame. Logs how often that was needed every 10 s. */
+static void dress_keep(uintptr_t player) {
+    static const uint32_t w_done[] = {0x52887508, 0x8b080008, 0xb9400109, 0x7100053f, 0x54000500, 0xb9400909};
+    static const uint32_t w_model[] = {0xf9411408, 0xb4000168, 0xf9400500, 0xb4000100, 0xf9400008};
+    static unsigned frames, moved;
+    uint32_t (*all_created)(uintptr_t) = (uint32_t (*)(uintptr_t))game_fn(0x1b7be9c, w_done, 6);
+    uintptr_t (*get_model)(uintptr_t) = (uintptr_t (*)(uintptr_t))game_fn(0xba8854, w_model, 5);
+    if (!all_created || !get_model) return;
+    uintptr_t world_model = get_model(player), world = world_model ? read_ptr(world_model + 0x60) : 0;
+    for (unsigned i = 0; i < stalker_count; i++) {
+        if (strcmp(stalkers[i].name, "PouchPlayer")) continue;
+        uintptr_t eu = pouch_eu(stalkers[i].actor);
+        if (eu && world && all_created(eu)) moved += dress_show(eu, world, true);
+    }
+    if (++frames == 600) { fprintf(stderr, "[survey] dress keep: %u pieces moved back to the world in 600 frames\n", moved); frames = moved = 0; }
+}
+/* The pieces the equipment user made sit in ActorLinks from eu+0x20, 0x18 apart: weapon 0, bow 3, shield 4, head 8, upper 9,
+   lower 10, sheath 11, quiver 14, the arm 18 (found with "survey peek euscan"); slot s of the armor is at eu+0xe0+(s-9)*0x18. get 0x1afbe4(link) returns
+   {actor, holds a reference} through x8 (the reference is a count at actor+0x1b0, dropped the way 0x1b6cd78 drops it).
+   A pouch user's pieces may be made for the menu's own scene, so each one is bound to the world scene and drawn everywhere,
+   like the body (pouch_show). */
+static unsigned dress_show(uintptr_t eu, uintptr_t world, bool quiet) {
+    static const uint32_t w_valid[] = {0xa9bd7bfd, 0xf9000bf5, 0xa9024ff4, 0x910003fd, 0xb9401008};
+    static const uint32_t w_get[] = {0xd10183ff, 0xa9017bfd, 0xf90013f9, 0xa9035ff8, 0xa90457f6};
+    static const uint32_t w_model[] = {0xf9411408, 0xb4000168, 0xf9400500, 0xb4000100, 0xf9400008};
+    static const uint32_t w_bind[] = {0xaa0003e8, 0xf9403000, 0xf100001f, 0xfa411004, 0x54000081};
+    static const uint32_t w_mask[] = {0x79449008, 0xb9401009, 0x6b08013f, 0x1a883128, 0x34000168};
+    typedef struct { uintptr_t actor; uint8_t held, pad[23]; } link_ref;   /* > 16 bytes: returned through x8, as the game does */
+    bool (*valid)(uintptr_t) = (bool (*)(uintptr_t))game_fn(0x1b2f20, w_valid, 5);
+    link_ref (*get)(uintptr_t) = (link_ref (*)(uintptr_t))game_fn(0x1afbe4, w_get, 5);
+    uintptr_t (*get_model)(uintptr_t) = (uintptr_t (*)(uintptr_t))game_fn(0xba8854, w_model, 5);
+    void (*bind)(uintptr_t, uintptr_t) = (void (*)(uintptr_t, uintptr_t))game_fn(0x585d58, w_bind, 5);
+    void (*set_mask)(uintptr_t, uint32_t) = (void (*)(uintptr_t, uint32_t))game_fn(0x50138c, w_mask, 5);
+    if (!valid || !get || !get_model || !bind || !set_mask) { fprintf(stderr, "[survey] dress show: function mismatch\n"); return 0; }
+    unsigned moved = 0;
+    for (int slot = 0; slot < 20; slot++) {   /* every link: weapons, armor, sheath, quiver, the arm (eu+0x20, 0x18 apart, their own order) */
+        uintptr_t link = eu + 0x20 + (uintptr_t)slot * 0x18;
+        if (!valid(link)) continue;
+        link_ref ref = get(link);
+        if (!ref.actor) continue;
+        char text[64] = {0};
+        read_mem(read_ptr(ref.actor + GAME_ACTOR_NAME), text, sizeof text - 1);
+        uintptr_t model = get_model(ref.actor), scene = model ? read_ptr(model + 0x60) : 0;
+        if (model && world && scene != world) {
+            bind(model, world);
+            set_mask(model, 0xffffffffu);
+            moved++;
+            if (!quiet) fprintf(stderr, "[survey] dress show: link %d %s (%#llx) model=%#llx scene %#llx -> %#llx\n", slot, text, (unsigned long long)ref.actor,
+                    (unsigned long long)model, (unsigned long long)scene, (unsigned long long)world);
+        }
+        if (ref.held) __atomic_fetch_sub((int32_t *)(ref.actor + 0x1b0), 1, __ATOMIC_SEQ_CST);
+    }
+    return moved;
+}
+static void dress_run(void) {
+    static const uint32_t w_equip[] = {0xd10383ff, 0xa9087bfd, 0xa9096ffc, 0xa90a67fa, 0xa90b5ff8, 0xa90c57f6};
+    void (*equip)(uintptr_t, uint32_t, const char **, int32_t, bool, bool) =
+        (void (*)(uintptr_t, uint32_t, const char **, int32_t, bool, bool))game_fn(0x1b6cd78, w_equip, 6);
+    if (!equip) { fprintf(stderr, "[survey] dress: function mismatch\n"); return; }
+    static const char *empty = "", *hand = "PlayerRaulHand", *hair = "Armor_999_Head", *upper = "Armor_Default_Upper", *lower = "Armor_Default_Lower";
+    static char held[64];   /* the game may keep the name pointer */
+    snprintf(held, sizeof held, "%s", dress_name);
+    static const char *one;
+    one = held;
+    for (unsigned i = 0; i < stalker_count; i++) {
+        if (strcmp(stalkers[i].name, "PouchPlayer")) continue;
+        uintptr_t eu = pouch_eu(stalkers[i].actor);
+        if (!eu) { fprintf(stderr, "[survey] dress: PouchPlayer %#llx has no equipment user\n", (unsigned long long)stalkers[i].actor); continue; }
+        if (dress_slot >= 0) {
+            equip(eu, (uint32_t)dress_slot, held[0] ? &one : &empty, held[0] ? dress_dye : -1, 0, 0);
+            fprintf(stderr, "[survey] dress: slot %d <- \"%s\"\n", dress_slot, held);
+        } else {   /* his own look (hair and underwear) by name, or twinning: "" is "whatever the player has on" */
+            equip(eu, 9, lonk_twin ? &empty : &hair, -1, 0, 0);
+            equip(eu, 10, lonk_twin ? &empty : &upper, -1, 0, 0);
+            equip(eu, 11, lonk_twin ? &empty : &lower, -1, 0, 0);
+            equip(eu, 19, &hand, -1, 0, 0);
+            if (lonk_twin) for (unsigned w = 0; w < 3; w++) equip(eu, (uint32_t[]){0, 7, 8}[w], &empty, -1, 0, 0);   /* and your sword, bow, shield */
+            if (lonk_twin) fprintf(stderr, "[survey] dress: twins (your outfit and weapons), arm %s\n", hand);
+            else fprintf(stderr, "[survey] dress: %s, %s, %s, arm %s\n", hair, upper, lower, hand);
+        }
+        dress_watch = 600;
+    }
+    dress_log("called", 0);
+}
+/* The name of the piece in one link of an equipment user ("" if none; links as in dress_show), through the same calls */
+static void eu_link_name(uintptr_t eu, unsigned index, char out[64]) {
+    static const uint32_t w_valid[] = {0xa9bd7bfd, 0xf9000bf5, 0xa9024ff4, 0x910003fd, 0xb9401008};
+    static const uint32_t w_get[] = {0xd10183ff, 0xa9017bfd, 0xf90013f9, 0xa9035ff8, 0xa90457f6};
+    typedef struct { uintptr_t actor; uint8_t held, pad[23]; } link_ref;
+    bool (*valid)(uintptr_t) = (bool (*)(uintptr_t))game_fn(0x1b2f20, w_valid, 5);
+    link_ref (*get)(uintptr_t) = (link_ref (*)(uintptr_t))game_fn(0x1afbe4, w_get, 5);
+    out[0] = 0;
+    uintptr_t link = eu + 0x20 + index * 0x18;
+    if (!eu || !valid || !get || !valid(link)) return;
+    link_ref ref = get(link);
+    if (!ref.actor) return;
+    read_mem(read_ptr(ref.actor + GAME_ACTOR_NAME), out, 63);
+    out[63] = 0;
+    if (ref.held) __atomic_fetch_sub((int32_t *)(ref.actor + 0x1b0), 1, __ATOMIC_SEQ_CST);
