+/* A wander goes somewhere he can actually get to: the best of 8 random directions (your way, if he's over 15 m off), 4
+   to 10 m, stopping short of walls and ledges. */
+static void lonk_pick_wander(const float a[3], const float p[3]) {
+    float d = frand(4, 10), way[2] = {1, 0}, offs[8], home = atan2f(p[2] - a[2], p[0] - a[0]);
+    int far = hypotf(p[0] - a[0], p[2] - a[2]) > 15;   /* far from you, he wanders back your way */
+    for (int i = 0; i < 8; i++) offs[i] = far ? home + frand(-1, 1) : frand(0, 6.2832f);
+#if defined(TOTK_GAME_V143)
+    if (ground_mode == GROUND_TERRAIN && isfinite(a[1])) {
+        float f = best_way(a, 0, offs, 8, d, way);
+        d = fminf(d, fmaxf(f - 0.6f, 0.5f));
+    } else
+#endif
+    { way[0] = cosf(offs[0]); way[1] = sinf(offs[0]); }
+    lonk_wander[0] = a[0] + way[0] * d; lonk_wander[2] = a[2] + way[1] * d;
+}
+/* Away from you, the clearest way near "straight away" (up to 120 degrees off); stuck, the way he was going counts
+   as blocked and the sides come first. */
+static void lonk_pick_flee(const float a[3], const float p[3], int stuck) {
+    float ax = a[0] - p[0], az = a[2] - p[2], l = hypotf(ax, az);
+    if (l < 0.01f) { ax = 1; az = 0; l = 1; }
+    float base = stuck ? atan2f(lonk_flee[1], lonk_flee[0]) : atan2f(az, ax), way[2] = {ax / l, az / l};
+    static const float near[] = {0, 0.52f, -0.52f, 1.05f, -1.05f, 1.57f, -1.57f, 2.09f, -2.09f};
+    static const float sides[] = {1.57f, -1.57f, 1.05f, -1.05f, 2.09f, -2.09f, 2.62f, -2.62f, 3.14f};
+#if defined(TOTK_GAME_V143)
+    if (ground_mode == GROUND_TERRAIN && isfinite(a[1])) best_way(a, base, stuck ? sides : near, 9, 8, way);
+#endif
+    lonk_flee[0] = way[0]; lonk_flee[1] = way[1];
+}
+/* Hide and seek: somewhere 6 to 14 m away he can run to in a straight line, but you can't see (a ray from your eyes to
+   his chest there hits something first). Returns 0 if there's nowhere. */
+static int lonk_pick_hide(const float a[3], const float p[3], float out[2]) {
+#if defined(TOTK_GAME_V143)
+    float base = frand(0, 6.2832f);
+    unsigned no_path = 0, no_floor = 0, seen = 0;
+    for (int k = 0; k < 24; k++) {
+        float r = base + k * 6.2832f / 24, dx = cosf(r), dz = sinf(r), d = frand(6, 14);
+        float free = path_free(a, dx, dz, d);
+        if (free < 6) { no_path++; continue; }
+        d = fminf(d, free - 0.5f);
+        float spot[3] = {a[0] + dx * d, a[1], a[2] + dz * d}, h;
+        if (!ray_height(spot[0], spot[2], a[1] + 2, a[1] - 3, &h) || fabsf(h - a[1]) > 0.8f) { no_floor++; continue; }   /* (below a ledge: he won't step off, and ran up and down its edge) */
+        float eye[3] = {p[0], p[1] + 1.6f, p[2]}, chest[3] = {spot[0], h + 1.0f, spot[2]}, hit[3];
+        if (!ray_cast(eye, chest, hit, NULL) || hypotf(hit[0] - chest[0], hit[2] - chest[2]) < 0.8f) { seen++; continue; }   /* in plain sight */
+        out[0] = spot[0]; out[1] = spot[2];
+        return 1;
+    }
+    fprintf(stderr, "[survey] lonk: nowhere to hide (%u blocked, %u no floor, %u in sight)\n", no_path, no_floor, seen);
+#endif
+    (void)a; (void)p; (void)out;
+    return 0;
+}
+/* Forgets bodies the game has taken apart (a death, a fast travel), before anything else touches them this frame: it runs
+   while the game is paused for a load too (lonk_step doesn't), since his gear and weapon code call into his body every frame,
+   and that crashed the game once the body's memory was reused. */
+static void stalkers_check(void) {
+    static const uint32_t w_body[] = {0xf9411408, 0xb4000168, 0xf9400500, 0xb4000100, 0xf9400008};
+    uintptr_t (*get_model)(uintptr_t) = (uintptr_t (*)(uintptr_t))game_fn(0xba8854, w_body, 5);
+    static KEEP uintptr_t had_model;   /* his body once it's had a model */
+    for (unsigned i = 0; i < stalker_count;) {
+        uintptr_t actor = stalkers[i].actor, name = read_ptr(actor + GAME_ACTOR_NAME);
+        char text[64] = {0};
+        float pos[3];
+        /* a death or a fast travel: the game takes his body apart (model and gear go first, the name much later). Writing
+           into it meanwhile (his animation slot goes with it) crashed the game on the second fast travel: so a body that's
+           lost its model is gone */
+        int pouch = !strcmp(stalkers[i].name, "PouchPlayer"), modeled = pouch && get_model && get_model(actor);
+        if (modeled) had_model = actor;
+        if (!name || !read_mem(name, text, sizeof text - 1) || strcmp(text, stalkers[i].name) ||
+            !read_mem(actor + ACTOR_POS, pos, sizeof pos) || !valid_xyz(pos) || (pouch && !modeled && had_model == actor)) {
+            if (had_model == actor) had_model = 0;
+            fprintf(stderr, "[survey] lonk: dropped %s (%#llx)\n", stalkers[i].name, (unsigned long long)actor);
+            /* he comes back with a mood running, brain or not (with the brain off he used to stay gone after a death or a
+               loading zone), and nothing of the old body carries over: its animation slot (freed with it), a jump, an emote */
+            if (!strcmp(stalkers[i].name, "PouchPlayer")) {
+                lonk_respawn_left = 120;
+                lonk_body = 0; lonk_air = 0; lonk_falling = 0; lonk_jump = 0; lonk_jump_aimed = 0; lonk_emote_left = 0; lonk_v = 0;
+            }
+            stalkers[i] = stalkers[--stalker_count];
+            continue;
+        }
+        ++i;
+    }
+}
