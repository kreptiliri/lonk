+#endif
+/* how long each emote lasts (frames); a jump lasts till he lands (this is just in case he never does) */
+static void lonk_emote_start(int gait) {
+    /* (in 60ths of a second; the clip's own end usually comes first now: these are in case it never does, except the
+       party, which holds its last pose till this runs out, and the jump, which ends when he lands) */
+    static const unsigned frames[GAITS] = {[GAIT_LOOK] = 480, [GAIT_SURPRISE] = 480, [GAIT_EAT] = 480, [GAIT_MEAL] = 480, [GAIT_YUCK] = 480,
+                                           [GAIT_JUMP] = 120, [GAIT_SULK] = 600, [GAIT_LOOKUP] = 480, [GAIT_PARTY] = 150, [GAIT_EQUIP] = 90};
+    if (lonk_air && gait != GAIT_JUMP) return;   /* in the air he's busy (a mood change used to start one mid-jump) */
+    if ((lonk_swim || lonk_climb) && gait != GAIT_JUMP) return;   /* (and swimming, climbing: a snack treading water stood him still, and he stopped following, seen) */
+    lonk_emote = gait; lonk_emote_left = frames[gait] ? frames[gait] : 120; lonk_emote_late = 0;
+    fprintf(stderr, "[survey] lonk: emote %s\n", gait_names[gait]);
