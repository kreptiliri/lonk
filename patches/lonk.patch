+static uintptr_t fuse_node_ok(uintptr_t n) { return n >= 0x100000000ull && n <= 0x7fffffffffffull && !(n & 7) ? n : 0; }
+static uint32_t fuse_key(uintptr_t n) { uint32_t k = 0; read_mem(n + 0x18, &k, 4); return k; }
+static uintptr_t fuse_root(uintptr_t from) {
+    uintptr_t n = from, up;
+    for (int k = 0; k < 64 && (up = fuse_node_ok(read_ptr(n + 0x10) & ~7ull)); k++) n = up;
+    return n;
+}
+static uintptr_t fuse_find(uintptr_t root, uint32_t key) {   /* the actor with creation number key under root, 0 if none */
+    uintptr_t n = root;
+    for (int k = 0; k < 64 && n; k++) {
+        uint32_t here = fuse_key(n);
+        if (here == key) return n - 0x390;
+        uintptr_t c0 = fuse_node_ok(read_ptr(n)), c1 = fuse_node_ok(read_ptr(n + 8)), next = 0;
+        /* (which side is smaller: whichever child's key is on that side) */
+        if (c0 && (key < here) == (fuse_key(c0) < here)) next = c0;
+        else if (c1 && (key < here) == (fuse_key(c1) < here)) next = c1;
+        n = next;
+    }
+    return 0;
+}
+static uintptr_t fuse_lookup(uintptr_t from, uint32_t key) { return fuse_find(fuse_root(from), key); }
