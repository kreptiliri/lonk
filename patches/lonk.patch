+    int far = hypotf(p[0] - a[0], p[2] - a[2]) > 15;   /* far from you, he wanders back your way */
+    for (int i = 0; i < 8; i++) offs[i] = far ? home + frand(-1, 1) : frand(0, 6.2832f);
