+/* The floor straight down from top to bottom, and how flat it is (up: the normal's y, 1 = flat, 0 = a wall) */
+static int ray_floor(float x, float z, float top, float bottom, float *out, float *up) {
+    float start[3] = {x, top, z}, end[3] = {x, bottom, z}, hit[3], normal[3];
+    /* a hit right at the start means the ray began inside something (a pillar, a mound): that's not a floor */
+    if (!ray_cast(start, end, hit, normal) || hit[1] > top - 0.02f || hit[1] < bottom - 0.01f) return 0;
+    float nl = sqrtf(normal[0] * normal[0] + normal[1] * normal[1] + normal[2] * normal[2]);
+    *out = hit[1];
+    if (up) *up = nl > 0.5f && nl < 1.5f ? normal[1] / nl : 1;
+    return 1;
+}
+static int ray_height(float x, float z, float top, float bottom, float *out) { return ray_floor(x, z, top, bottom, out, NULL); }
+/* Something in the way, knee high, within <reach> m along (dx, dz)? A walkable slope (normal pointing up) doesn't count. */
+static int ray_blocked(const float at[3], float dx, float dz, float reach) {
