+#if defined(TOTK_GAME_V143)
+/* idle, walk, run or dash from his speed (no walk, at first: keeping your walking pace, his run looked like running
+   while holding back, Camille said). The bands overlap by 0.3 m/s each side. Between moving gaits a new one holds for 12 frames (your sprint dips, and he'd flicker); to start
+   or stop, 2: that used to be 12 too, on a speed smoothed over 20 more, so he ran on the spot for half a second after
+   every stop (and slid off in his idle pose at every start). Braking to a stop (stopping), he goes to the idle right away,
+   the way Link's brake starts as soon as you let go: its 10-frame fade then ends about when he does. Called every frame,
+   emotes or not, so a gait from before an emote doesn't come back after it (it did: 12 frames of running on the spot). */
+static int lonk_move_gait(float v, int stopping) {
+    static const float edge[3] = {0.4f, 4.0f, 7.3f};   /* idle | walk | run | dash (Link's walk fades into his run from 2.9 to 5.6 m/s) */
+    static int g = GAIT_IDLE;
+    static unsigned held;
+    int want = g;
+    while (want < GAIT_DASH && v > edge[want] + 0.3f) want++;
+    while (want > GAIT_IDLE && v < edge[want - 1] - 0.3f) want--;
+    if (stopping) want = GAIT_IDLE;
+    held = want == g ? 0 : held + 1;
+    if (held >= (want == GAIT_IDLE || g == GAIT_IDLE ? 2u : 12u)) { g = want; held = 0; }
+    return g;
+}
