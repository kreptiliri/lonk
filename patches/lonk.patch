+/* The name of the piece in one link of an equipment user ("" if none; links as in dress_show), through the same calls */
+static void eu_link_name(uintptr_t eu, unsigned index, char out[64]) {
+    static const uint32_t w_valid[] = {0xa9bd7bfd, 0xf9000bf5, 0xa9024ff4, 0x910003fd, 0xb9401008};
+    static const uint32_t w_get[] = {0xd10183ff, 0xa9017bfd, 0xf90013f9, 0xa9035ff8, 0xa90457f6};
+    typedef struct { uintptr_t actor; uint8_t held, pad[23]; } link_ref;
+    bool (*valid)(uintptr_t) = (bool (*)(uintptr_t))game_fn(0x1b2f20, w_valid, 5);
+    link_ref (*get)(uintptr_t) = (link_ref (*)(uintptr_t))game_fn(0x1afbe4, w_get, 5);
+    out[0] = 0;
+    uintptr_t link = eu + 0x20 + index * 0x18;
+    if (!eu || !valid || !get || !valid(link)) return;
+    link_ref ref = get(link);
+    if (!ref.actor) return;
+    read_mem(read_ptr(ref.actor + GAME_ACTOR_NAME), out, 63);
+    out[63] = 0;
+    if (ref.held) __atomic_fetch_sub((int32_t *)(ref.actor + 0x1b0), 1, __ATOMIC_SEQ_CST);
+}
+/* "survey peek euscan": every ActorLink-looking spot in his equipment user (a heap pointer at +8) that resolves to an actor */
+static void eu_scan(uintptr_t eu) {
+    static const uint32_t w_valid[] = {0xa9bd7bfd, 0xf9000bf5, 0xa9024ff4, 0x910003fd, 0xb9401008};
+    static const uint32_t w_get[] = {0xd10183ff, 0xa9017bfd, 0xf90013f9, 0xa9035ff8, 0xa90457f6};
+    typedef struct { uintptr_t actor; uint8_t held, pad[23]; } link_ref;
+    bool (*valid)(uintptr_t) = (bool (*)(uintptr_t))game_fn(0x1b2f20, w_valid, 5);
+    link_ref (*get)(uintptr_t) = (link_ref (*)(uintptr_t))game_fn(0x1afbe4, w_get, 5);
+    if (!eu || !valid || !get) return;
+    for (uintptr_t off = 0; off < 0x4400; off += 8) {
+        uintptr_t q = read_ptr(eu + off + 8), id = read_ptr(eu + off + 0x10);
+        if (q < 0x100000000ull || q > 0x7fffffffffffull || (q & 7) || !id) continue;
+        uint64_t probe;
+        if (!read_mem(q, &probe, 8) || !valid(eu + off)) continue;
+        link_ref ref = get(eu + off);
+        if (!ref.actor) continue;
+        char text[64] = {0};
+        read_mem(read_ptr(ref.actor + GAME_ACTOR_NAME), text, sizeof text - 1);
+        fprintf(stderr, "[survey] euscan: eu+%#llx -> %s\n", (unsigned long long)off, text);
+        if (ref.held) __atomic_fetch_sub((int32_t *)(ref.actor + 0x1b0), 1, __ATOMIC_SEQ_CST);
+    }
+}
+/* His weapons on his back. A pouch user's weapons come out drawn (in his hands: his sword and shield sat there through
+   every run); the menu's AI node OneShotChangeDrawnSwordStateForPouchPlayer (getName 0x2508168, run 0x2507a80, found
+   through its name string and its vtable) puts them away, when you hold nothing in the menu, with 0x4f5194(eu, link, 0)
+   on the weapon (0), the shield (4) and the bow (3): it sets the link's state byte (eu+0x4620+link) to 4 and clears
+   its "drawn" flag; 0x4f5700(eu, link) is the other way round (state 2, drawn). Not solved: "survey lonk sheathe" does
+   that (the states go 0 -> 4, and back to 0 a frame or so later) and his sword stays in his hand, even called every frame
+   or before a re-equip. Next to look at: the bone the weapon piece is attached to, the IsAlwaysASTrgDrawn parameter. */
+static KEEP int sheathe_request;
+static void lonk_sheathe(void) {
+    static const uint32_t w_sheathe[] = {0xd10183ff, 0xa9017bfd, 0xf90013f9, 0xa9035ff8, 0xa90457f6, 0xa9054ff4};
+    void (*sheathe)(uintptr_t, uint32_t, uint32_t) = (void (*)(uintptr_t, uint32_t, uint32_t))game_fn(0x4f5194, w_sheathe, 6);
+    if (!sheathe) { fprintf(stderr, "[survey] sheathe: function mismatch\n"); return; }
+    for (unsigned i = 0; i < stalker_count; i++) {
+        if (strcmp(stalkers[i].name, "PouchPlayer")) continue;
+        uintptr_t eu = pouch_eu(stalkers[i].actor);
+        if (!eu) continue;
+        uint8_t before[8] = {0}, after[8] = {0};
+        read_mem(eu + 0x4620, before, sizeof before);
+        for (unsigned k = 0; k < 3; k++) sheathe(eu, (uint32_t[]){0, 4, 3}[k], 0);
+        read_mem(eu + 0x4620, after, sizeof after);
+        fprintf(stderr, "[survey] sheathe: states weapon/bow/shield %u/%u/%u -> %u/%u/%u\n", before[0], before[3], before[4], after[0], after[3], after[4]);
