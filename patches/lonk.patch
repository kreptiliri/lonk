+    }
+    impl->init(survey_module);
+    const struct survey_impl *old = atomic_load(&survey_live);
+    int kept = keep_copy((const void *)old->tick, (const void *)impl->tick);
+    atomic_store(&survey_live, impl);
+    fprintf(stderr, "[lonk-reload] %s: load %u, %d variables of his state kept\n", why, plugin_loads, kept);
