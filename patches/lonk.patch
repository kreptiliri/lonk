+#ifdef SURVEY_SPAWN
+/* The created actor, once the PreActor holds it: a pointer in the PreActor's first 0x100 bytes whose actor name is the
+   requested one (1.2.1 keeps it at +0x20; found by name here so a moved field shows in the log instead of misreading). */
+static uintptr_t spawn_find_actor(unsigned *at) {
+    for (unsigned off = 0; off < 0x100; off += 8) {
+        uintptr_t actor = read_ptr(spawn_pre + off), name = actor ? read_ptr(actor + GAME_ACTOR_NAME) : 0;
+        char text[64] = {0};
+        if (name && read_mem(name, text, sizeof text - 1) && !strcmp(text, spawn_name)) { *at = off; return actor; }
+    }
+    return 0;
+}
+static void spawn_request(const char *tag, const char *name, const float *off, uint64_t frame, uintptr_t player) {
+    float pos[3], rot[9];
+    void *mgr = (void *)read_ptr(survey_main + SPAWN_MGR);
+    if (!survey_spawn_create || !mgr) { fprintf(stderr, "[survey] tag=%s status=spawn_unavailable fn=%d mgr=%p\n", tag, survey_spawn_create != 0, mgr); return; }
+    if (!read_mem(player + ACTOR_POS, pos, sizeof pos) || !read_mem(player + ACTOR_ROT, rot, sizeof rot)) { report(tag, "no_player", frame, 0); return; }
+    /* the player's facing: the rotation's local Z axis (third column), flattened */
+    float fx = rot[2], fz = rot[8], len = sqrtf(fx * fx + fz * fz);
+    if (!isfinite(len) || len < 0.1f) { fx = 0; fz = 1; len = 1; }
+    struct spawn_create_arg arg;
+    memset(&arg, 0, sizeof arg);
+    /* off = {forward m, sideways m, up m}; default 2, 0, 1.5 */
+    arg.position[0] = pos[0] + (off[0] * fx - off[1] * fz) / len; arg.position[1] = pos[1] + off[2]; arg.position[2] = pos[2] + (off[0] * fz + off[1] * fx) / len;
+    arg.rotation[0] = arg.rotation[4] = arg.rotation[8] = 1.0f;
+    arg.scale[0] = arg.scale[1] = arg.scale[2] = 1.0f;
+    arg.name = "";
+    arg.transform_flags = 0x7;
+    static const char *create_name;   /* the SafeString the game reads the name through */
+    static uint32_t result;
+    static void *pre;
+    create_name = spawn_name; result = 0xffffffffu; pre = NULL;
+    strcpy(spawn_name, name); strcpy(spawn_tag, tag);
+    fprintf(stderr, "[survey] tag=%s status=spawn_call frame=%llu name=%s player=%.3f,%.3f,%.3f at=%.3f,%.3f,%.3f mgr=%p\n", tag,
+            (unsigned long long)frame, spawn_name, pos[0], pos[1], pos[2], arg.position[0], arg.position[1], arg.position[2], mgr);
+    bool ok = survey_spawn_create(mgr, &create_name, &arg, NULL, 1 /* CreatePriority::High */, NULL, NULL, NULL, 0, &result, &pre);
+    fprintf(stderr, "[survey] tag=%s status=spawn_requested frame=%llu ok=%d result=%u preactor=%p\n", tag, (unsigned long long)frame, ok, result, pre);
+    if (ok && pre) { spawn_pre = (uintptr_t)pre; spawn_left = SPAWN_WATCH_FRAMES; }
+}
+static void spawn_watch(uint64_t frame) {
+    unsigned at = 0;
+    uintptr_t actor = spawn_find_actor(&at);
+    float xyz[3];
+    if (actor && read_mem(actor + ACTOR_POS, xyz, sizeof xyz)) {
+        fprintf(stderr, "[survey] tag=%s status=spawned frame=%llu preactor=%#llx actor=%#llx (preactor+%#x) name=%s xyz=%.3f,%.3f,%.3f\n", spawn_tag,
+                (unsigned long long)frame, (unsigned long long)spawn_pre, (unsigned long long)actor, at, spawn_name, xyz[0], xyz[1], xyz[2]);
+        spawn_left = 0;
+        if (spawn_body && stalker_count < STALK_MAX) { stalkers[stalker_count].actor = actor; strcpy(stalkers[stalker_count++].name, spawn_name); }
+    } else if (!--spawn_left) {
+        uint64_t head[8] = {0}; read_mem(spawn_pre, head, sizeof head);
+        fprintf(stderr, "[survey] tag=%s status=spawn_no_actor frame=%llu preactor=%#llx head=%llx %llx %llx %llx %llx %llx %llx %llx\n", spawn_tag,
+                (unsigned long long)frame, (unsigned long long)spawn_pre, (unsigned long long)head[0], (unsigned long long)head[1], (unsigned long long)head[2],
+                (unsigned long long)head[3], (unsigned long long)head[4], (unsigned long long)head[5], (unsigned long long)head[6], (unsigned long long)head[7]);
+    }
+}
+static float frand(float lo, float hi) { return lo + (hi - lo) * (float)arc4random_uniform(1u << 24) / (float)(1u << 24); }
+static void lonk_enter(int kind, unsigned frames) {
+    lonk_kind = kind; lonk_entered = 0; lonk_gifted = 0; lonk_phase_left = frames;
+    fprintf(stderr, "[survey] lonk: -> %s (%u frames)\n", lonk_names[kind], frames);
+}
+/* The dice: mostly stalking, sometimes in the way, a gift, a wander or right behind you. */
+static void lonk_roll(void) {
+    unsigned weight[LONK_KINDS] = {30, 20, 15, 15, 20, 0};
+    static int last_kind = -1;
+    if (last_kind == LONK_GIFT) weight[LONK_GIFT] = 0;   /* no two gifts in a row */
+    unsigned total = 0, pick;
+    for (int k = 0; k < LONK_KINDS; k++) total += weight[k];
+    pick = arc4random_uniform(total);
+    int kind = 0;
+    while (pick >= weight[kind]) pick -= weight[kind++];
+    last_kind = kind;
+    lonk_enter(kind, kind == LONK_BEHIND ? 240 + arc4random_uniform(120) : 360 + arc4random_uniform(360));
+}
+/* Ground height near (x, z): the nearest of the player's recent footsteps within 25 m, else the player's own height. */
+static float trail_height(float x, float z, float fallback) {
+    float best = 25 * 25, y = fallback;
+    for (unsigned i = 0; i < trail_count; i++) {
+        float dx = trail[i][0] - x, dz = trail[i][2] - z, d = dx * dx + dz * dz;
+        if (d < best) { best = d; y = trail[i][1]; }
+    }
+    return y;
+}
+/* One frame of Lonk: the behaviour moves the anchor (yaw only; local Z = facing, as spawn_request reads it), then every live
+   body piece is put there. A piece whose name no longer reads back is dropped. */
+static void lonk_step(uint64_t frame, uintptr_t player) {
+    float p[3], rot[9];
+    if (!read_mem(player + ACTOR_POS, p, sizeof p) || !read_mem(player + ACTOR_ROT, rot, sizeof rot)) return;
+    float fx = rot[2], fz = rot[8], flen = sqrtf(fx * fx + fz * fz);
+    if (!isfinite(flen) || flen < 0.1f) { fx = 0; fz = 1; } else { fx /= flen; fz /= flen; }
+    /* footsteps: a new one every 25 cm the player moves */
+    unsigned last = (trail_head + TRAIL_MAX - 1) % TRAIL_MAX;
+    if (!trail_count || hypotf(p[0] - trail[last][0], p[2] - trail[last][2]) > 0.25f) {
+        memcpy(trail[trail_head], p, sizeof p); trail_head = (trail_head + 1) % TRAIL_MAX;
+        if (trail_count < TRAIL_MAX) trail_count++;
+    }
+    for (unsigned i = 0; i < stalker_count;) {
+        uintptr_t actor = stalkers[i].actor, name = read_ptr(actor + GAME_ACTOR_NAME);
+        char text[64] = {0};
+        float pos[3];
+        if (!name || !read_mem(name, text, sizeof text - 1) || strcmp(text, stalkers[i].name) ||
+            !read_mem(actor + ACTOR_POS, pos, sizeof pos) || !valid_xyz(pos)) {
+            fprintf(stderr, "[survey] lonk: dropped %s (%#llx)\n", stalkers[i].name, (unsigned long long)actor);
+            stalkers[i] = stalkers[--stalker_count];
+            continue;
+        }
+        if (!lonk_anchored) { memcpy(lonk_anchor, pos, sizeof pos); lonk_anchored = 1; }
+        ++i;
+    }
+    if (!stalker_count || !lonk_anchored) return;
+    if (lonk_brain && !lonk_phase_left) lonk_roll();
+    if (lonk_phase_left) lonk_phase_left--;
+    float *a = lonk_anchor, target[3] = {p[0], p[1], p[2]}, speed = stalk_speed, stop = stalk_stop;
+    int face_player = 1, entering = !lonk_entered;
+    lonk_entered = 1;
+    switch (lonk_kind) {
+    case LONK_BLOCK: target[0] = p[0] + fx * 2.5f; target[2] = p[2] + fz * 2.5f; speed = 7; stop = 0.2f; break;
+    case LONK_BEHIND:
+        if (entering) { a[0] = p[0] - fx * 1.5f; a[2] = p[2] - fz * 1.5f; }   /* he was always there */
+        speed = 4; stop = 1.2f; break;
+    case LONK_WANDER:
+        if (entering) { float r = frand(0, 6.2832f), d = frand(4, 10); lonk_wander[0] = a[0] + cosf(r) * d; lonk_wander[2] = a[2] + sinf(r) * d; }
+        target[0] = lonk_wander[0]; target[2] = lonk_wander[2]; speed = 1.5f; stop = 0.3f; face_player = 0; break;
+    case LONK_GIFT:
+        speed = 4; stop = 2;
+        if (!lonk_gifted && hypotf(p[0] - a[0], p[2] - a[2]) < 2.4f && !spawn_left) {
+            float off[3] = {1.2f, frand(-1, 1), 1.0f};
+            spawn_body = 0;
+            spawn_request("gift", arc4random_uniform(4) ? "Item_Fruit_A" : "BarrelBomb", off, frame, player);
+            lonk_gifted = 1;
+            lonk_enter(LONK_FLEE, 240);
+        }
+        break;
+    case LONK_FLEE: {
+        float ax = a[0] - p[0], az = a[2] - p[2], l = hypotf(ax, az);
+        if (l < 0.01f) { ax = -fx; az = -fz; l = 1; }
+        target[0] = a[0] + ax / l * 5; target[2] = a[2] + az / l * 5; speed = 7; stop = 0; face_player = 0; break;
+    }
+    default: break;
+    }
+    float dx = target[0] - a[0], dz = target[2] - a[2], dist = hypotf(dx, dz);
+    if (dist > 0.01f) {
+        float step = fminf(speed / 60.0f, fmaxf(dist - stop, 0.0f));
+        a[0] += dx / dist * step; a[2] += dz / dist * step;
+    }
+    /* Never through the player: overlapping Link reads as a low ceiling and forces a crouch, so keep 1.1 m and slide round */
+    float ox = a[0] - p[0], oz = a[2] - p[2], od = hypotf(ox, oz);
+    if (od < 1.1f) {
+        if (od < 0.01f) { ox = -fx; oz = -fz; od = 1; }
+        a[0] = p[0] + ox / od * 1.1f; a[2] = p[2] + oz / od * 1.1f;
+    }
+    float hx = face_player ? p[0] - a[0] : dx, hz = face_player ? p[2] - a[2] : dz, hl = hypotf(hx, hz);
+    if (hl < 0.01f) { hx = -fx; hz = -fz; hl = 1; }
+    hx /= hl; hz /= hl;
+    float ground = ground_mode == GROUND_TRAIL ? trail_height(a[0], a[2], p[1]) : p[1];
+    /* ease toward the new height (no pops when the nearest footstep changes); a teleport snaps */
+    if (!(lonk_kind == LONK_BEHIND && entering) && isfinite(a[1]) && fabsf(ground - a[1]) < 30) ground = a[1] + (ground - a[1]) * 0.15f;
+    for (unsigned i = 0; i < stalker_count; i++) {
+        float y = ground;
+        if (ground_mode == GROUND_PHYSICS) read_mem(stalkers[i].actor + ACTOR_POS + 4, &y, sizeof y);   /* keep its own height */
+        float matrix[12] = {hz, 0, hx, a[0],
+                            0,  1, 0,  y,
+                            -hx, 0, hz, a[2]};
+        survey_force((void *)stalkers[i].actor, matrix, 0);
+    }
+    a[1] = ground;
+    if (frame % 60 == 0) fprintf(stderr, "[survey] lonk: frame=%llu %s ground=%s dist=%.2f y=%.2f player_y=%.2f\n", (unsigned long long)frame,
+                                 lonk_names[lonk_kind], ground_names[ground_mode], hypotf(p[0] - a[0], p[2] - a[2]), ground, p[1]);
+}
