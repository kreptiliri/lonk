+    impl->init(survey_module);
+    const struct survey_impl *old = atomic_load(&survey_live);
+    int kept = keep_copy((const void *)old->tick, (const void *)impl->tick);
+    atomic_store(&survey_live, impl);
+    fprintf(stderr, "[lonk-reload] %s: load %u, %d variables of his state kept\n", why, plugin_loads, kept);
+}
+void runtime_survey_init(Module *m) {
+    survey_module = m;
+    survey_local_init(m);
+    const char *path = getenv("TOTK_LONK_PLUGIN");
+    if (!path || !*path || !survey_enabled) return;
+    plugin_path = strdup(path);
+    if (plugin_path && plugin_changed()) plugin_load("start");
+    else fprintf(stderr, "[lonk-reload] waiting for %s\n", path);
+}
+int runtime_survey_command(const char *line) {
+    if (plugin_path && !strncmp(line, "survey ", 7)) {
+        int asked = !strncmp(line, "survey reload", 13);
+        if (asked || plugin_changed()) { atomic_store(&plugin_reload, 1); atomic_store_explicit(&runtime_survey_pending, 1, memory_order_release); }
+        if (asked) return 1;
+    }
+    return atomic_load(&survey_live)->command(line);
+}
+void runtime_survey_tick(uint64_t frame) {
+    if (plugin_path && (atomic_exchange(&plugin_reload, 0) || (frame % 30 == 0 && plugin_changed()))) plugin_load("changed");
+    atomic_load(&survey_live)->tick(frame);
+}
+void runtime_survey_cancel_user(void) { atomic_load(&survey_live)->cancel_user(); }
