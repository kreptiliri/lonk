+#ifndef LONK_PLUGIN
+/* Hot reload: TOTK_LONK_PLUGIN names a dylib built from this file with -DLONK_PLUGIN (lonk's tools/plugin.sh). It's loaded
+   at start, and again when the file changes (checked every 30 game frames while the survey runs, and before each command)
+   or on "survey reload". Each load is a fresh copy of the file (dyld hands back the image it already has for a path); the
+   new copy's init runs, its KEEP variables get the running copy's (by name, from both symbol tables), and the survey
+   switches over on the game's frame-end thread, between two ticks. An old copy is never unloaded: a command may
+   still be running in it. */
+#include <copyfile.h>
+#include <dlfcn.h>
+#include <mach-o/getsect.h>
+#include <mach-o/loader.h>
+#include <mach-o/nlist.h>
+#include <sys/stat.h>
+#undef runtime_survey_init
+#undef runtime_survey_command
+#undef runtime_survey_tick
+#undef runtime_survey_cancel_user
+struct survey_impl { void (*init)(Module *); int (*command)(const char *); void (*tick)(uint64_t); void (*cancel_user)(void); };
+static const struct survey_impl survey_local = {survey_local_init, survey_local_command, survey_local_tick, survey_local_cancel_user};
+static const struct survey_impl *_Atomic survey_live = &survey_local;
+static Module *survey_module;
+static char *plugin_path;
+static struct timespec plugin_seen;
+static unsigned plugin_loads;
+static _Atomic int plugin_reload;
+static pthread_mutex_t plugin_lock = PTHREAD_MUTEX_INITIALIZER;
+/* The KEEP variables of the image holding <code>: name, address and size (up to the next one, or the section's end), read
+   from the image's own symbol table (statics keep their symbols: nothing here is stripped). */
+struct keep_var { const char *name; uint8_t *at; size_t size; };
+static int keep_cmp(const void *x, const void *y) {
+    const struct keep_var *a = x, *b = y;
+    return a->at < b->at ? -1 : a->at > b->at;
+}
+static unsigned keep_vars(const void *code, struct keep_var *out, unsigned max) {
+    Dl_info info;
+    if (!dladdr(code, &info)) return 0;
+    const struct mach_header_64 *mh = info.dli_fbase;
+    unsigned long size = 0;
+    uint8_t *section = getsectiondata(mh, "__DATA", "__lonk_keep", &size);
+    const struct load_command *lc = (const void *)(mh + 1);
+    const struct symtab_command *st = NULL;
+    const struct segment_command_64 *linkedit = NULL, *text = NULL;
+    unsigned keep_index = 0, index = 0;
+    for (uint32_t i = 0; i < mh->ncmds; i++, lc = (const void *)((const uint8_t *)lc + lc->cmdsize)) {
+        if (lc->cmd == LC_SYMTAB) st = (const void *)lc;
+        if (lc->cmd != LC_SEGMENT_64) continue;
+        const struct segment_command_64 *seg = (const void *)lc;
+        if (!strcmp(seg->segname, "__LINKEDIT")) linkedit = seg;
+        if (!strcmp(seg->segname, "__TEXT")) text = seg;
+        const struct section_64 *sec = (const void *)(seg + 1);
+        for (uint32_t k = 0; k < seg->nsects; k++) { index++; if (!strcmp(sec[k].sectname, "__lonk_keep")) keep_index = index; }
+    }
+    if (!section || !st || !linkedit || !text || !keep_index) return 0;
+    intptr_t slide = (intptr_t)mh - (intptr_t)text->vmaddr;
+    const uint8_t *base = (const uint8_t *)(linkedit->vmaddr + slide - linkedit->fileoff);
+    const struct nlist_64 *sym = (const void *)(base + st->symoff);
+    const char *names = (const char *)(base + st->stroff);
+    unsigned n = 0;
+    for (uint32_t i = 0; i < st->nsyms && n < max; i++)
+        if ((sym[i].n_type & N_TYPE) == N_SECT && !(sym[i].n_type & N_STAB) && sym[i].n_sect == keep_index)
+            out[n++] = (struct keep_var){names + sym[i].n_un.n_strx, (uint8_t *)(sym[i].n_value + slide), 0};
+    qsort(out, n, sizeof *out, keep_cmp);
+    for (unsigned i = 0; i < n; i++) out[i].size = (size_t)((i + 1 < n ? out[i + 1].at : section + size) - out[i].at);
+    return n;
+}
+/* Copies every KEEP variable both copies have, by name (a variable added, removed or moved doesn't shift the others);
+   returns how many, or -1 without symbols */
+static int keep_copy(const void *from_code, const void *to_code) {
+    static struct keep_var from[256], to[256];
+    unsigned nf = keep_vars(from_code, from, 256), nt = keep_vars(to_code, to, 256);
+    if (!nf || !nt) return -1;
+    int copied = 0;
+    for (unsigned i = 0; i < nt; i++)
+        for (unsigned k = 0; k < nf; k++)
+            if (!strcmp(to[i].name, from[k].name) && to[i].size == from[k].size) { memcpy(to[i].at, from[k].at, to[i].size); copied++; break; }
+    return copied;
+}
+static int plugin_changed(void) {
+    struct stat st;
+    pthread_mutex_lock(&plugin_lock);
+    int changed = !stat(plugin_path, &st) && st.st_size > 0 &&
+                  (st.st_mtimespec.tv_sec != plugin_seen.tv_sec || st.st_mtimespec.tv_nsec != plugin_seen.tv_nsec);
+    if (changed) plugin_seen = st.st_mtimespec;
+    pthread_mutex_unlock(&plugin_lock);
+    return changed;
+}
+static void plugin_load(const char *why) {
+    char copy[PATH_MAX];
+    const char *tmp = getenv("TMPDIR");
+    snprintf(copy, sizeof copy, "%s/lonk-%d-%u.dylib", tmp && *tmp ? tmp : "/tmp", getpid(), ++plugin_loads);
+    if (copyfile(plugin_path, copy, NULL, COPYFILE_DATA | COPYFILE_STAT)) { fprintf(stderr, "[lonk-reload] can't copy %s\n", plugin_path); return; }
+    void *h = dlopen(copy, RTLD_NOW | RTLD_LOCAL);
+    unlink(copy);
+    struct survey_impl *impl = h ? calloc(1, sizeof *impl) : NULL;
+    if (impl) {
+        impl->init = (void (*)(Module *))dlsym(h, "lonk_plugin_init");
+        impl->command = (int (*)(const char *))dlsym(h, "lonk_plugin_command");
+        impl->tick = (void (*)(uint64_t))dlsym(h, "lonk_plugin_tick");
+        impl->cancel_user = (void (*)(void))dlsym(h, "lonk_plugin_cancel_user");
+    }
+    if (!impl || !impl->init || !impl->command || !impl->tick || !impl->cancel_user) {
+        fprintf(stderr, "[lonk-reload] %s: load %u failed: %s\n", why, plugin_loads, h ? "entry points missing" : dlerror());
