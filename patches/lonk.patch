+   (0x26f0448) reads it the same way, through 0x1cf46d4 and 0x5fe3b0. */
+static uintptr_t ray_hit_actor(void) {
+    uintptr_t body = ray_last ? read_ptr((uintptr_t)(ray_last + 0x170)) : 0, holder = body ? read_ptr(body + 0x110) : 0;
+    if (!holder) return 0;
