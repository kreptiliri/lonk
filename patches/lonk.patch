+    /* chest high too: a wall that leans out at the bottom reads as a walkable slope at the knee, and he walked into it */
+    float chest[3] = {at[0], at[1] + 1.3f, at[2]}, chest_end[3] = {at[0] + dx * reach, at[1] + 1.3f, at[2] + dz * reach};
+    if (ray_cast(chest, chest_end, hit, NULL)) return 1;
+    if (!ray_cast(start, end, hit, normal)) return 0;
+    float nl = sqrtf(normal[0] * normal[0] + normal[1] * normal[1] + normal[2] * normal[2]);
+    if (nl > 0.5f && nl < 1.5f && normal[1] / nl > 0.65f) return 0;
+    /* a stair: what he hit has its top a step above his knee, rising gently from his feet. Going up stairs the knee ray
+       hit the steps a metre ahead as walls and he swerved out and back every few frames (tested) */
+    float d = hypotf(hit[0] - at[0], hit[2] - at[2]), h;
+    if (ray_height(hit[0] + dx * 0.2f, hit[2] + dz * 0.2f, at[1] + 0.95f, at[1] + 0.6f, &h) && h - at[1] < 0.7f * (d + 0.2f) + 0.2f) return 0;
