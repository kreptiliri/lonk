+/* The clearest of <tries> directions: the first that's free for <want> m, else the one that goes furthest. Directions
+   are (base angle + offs[i]); returns the free length and the direction in out. */
+static float best_way(const float at[3], float base, const float *offs, int tries, float want, float out[2]) {
+    float best = -1;
+    for (int i = 0; i < tries; i++) {
+        float r = base + offs[i], dx = cosf(r), dz = sinf(r), f = path_free(at, dx, dz, want);
+        if (f > best) { best = f; out[0] = dx; out[1] = dz; }
+        if (f >= want) break;
+    }
+    return best;
+}
+/* Somewhere to put him next to the player (p, facing fx, fz), wherever there's flat floor about as high as the player's. */
+static void spot_near(const float p[3], float fx, float fz, float out[2]) {
+    /* behind first, then the sides, then in front, at 1.5 m, then 2.5 and 1 m; nowhere at all (a nook): your own spot,
+       and the keep-out nudges him off you (before, "behind anyway" could be over a hole, and he was lost again) */
+    static const float dirs[8][2] = {{-1, 0}, {0, 1}, {0, -1}, {-0.7f, 0.7f}, {-0.7f, -0.7f}, {0.7f, 0.7f}, {0.7f, -0.7f}, {1, 0}};   /* (forward, right) */
+    static const float reach[3] = {1.5f, 2.5f, 1.0f};
+    for (int r = 0; r < 3; r++)
+        for (int i = 0; i < 8; i++) {
+            float x = p[0] + (fx * dirs[i][0] - fz * dirs[i][1]) * reach[r], z = p[2] + (fz * dirs[i][0] + fx * dirs[i][1]) * reach[r], h, up;
+            if (ray_floor(x, z, p[1] + 0.7f, p[1] - 1.0f, &h, &up) && up > 0.6f) { out[0] = x; out[1] = z; return; }
+        }
+    out[0] = p[0]; out[1] = p[2];
