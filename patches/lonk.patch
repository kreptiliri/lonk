+static void weapon_scan(uintptr_t eu, const char *who) {
+    static const uint32_t w_valid[] = {0xa9bd7bfd, 0xf9000bf5, 0xa9024ff4, 0x910003fd, 0xb9401008};
+    static const uint32_t w_get[] = {0xd10183ff, 0xa9017bfd, 0xf90013f9, 0xa9035ff8, 0xa90457f6};
+    typedef struct { uintptr_t actor; uint8_t held, pad[23]; } link_ref;
+    bool (*valid)(uintptr_t) = (bool (*)(uintptr_t))game_fn(0x1b2f20, w_valid, 5);
+    link_ref (*get)(uintptr_t) = (link_ref (*)(uintptr_t))game_fn(0x1afbe4, w_get, 5);
+    if (!eu || !valid || !get) { fprintf(stderr, "[survey] wscan %s: no equipment user\n", who); return; }
+    for (unsigned k = 0; k < 2; k++) {
+        uintptr_t link = eu + 0x20 + (k ? 4 : 0) * 0x18;
+        if (!valid(link)) continue;
+        link_ref ref = get(link);
+        if (!ref.actor) continue;
+        char text[64], path[32];
+        actor_name_at(ref.actor, text);
+        {
+            float at[3] = {NAN, NAN, NAN};
+            read_mem(ref.actor + ACTOR_POS, at, sizeof at);
+            fprintf(stderr, "[survey] wscan %s: link %d = %s (%#llx) at %.2f,%.2f,%.2f\n", who, k ? 4 : 0, text, (unsigned long long)ref.actor, at[0], at[1], at[2]);
+        }
+        weapon_scan_area(ref.actor, 0x1000, ref.actor, who, "w");
+        {   /* the component that points at your fused part (w+0x398), raw */
+            uintptr_t c = read_ptr(ref.actor + 0x398);
+            uint64_t q[16] = {0};
+            read_mem(c, q, sizeof q);
+            fprintf(stderr, "[survey] wscan %s: w+0x398 = %#llx:", who, (unsigned long long)c);
+            for (int k = 0; k < 16; k++) fprintf(stderr, " %llx", (unsigned long long)q[k]);
+            fprintf(stderr, "\n");
+        }
+        for (uintptr_t off = 0; off < 0x1000; off += 8) {   /* one pointer deeper: its components */
+            uintptr_t c = read_ptr(ref.actor + off);
+            uint64_t probe;
+            if (c < 0x100000000ull || c > 0x7fffffffffffull || (c & 7) || c == ref.actor || !read_mem(c, &probe, 8)) continue;
+            snprintf(path, sizeof path, "w+%#llx>", (unsigned long long)off);
+            weapon_scan_area(c, 0x300, ref.actor, who, path);
+        }
+        if (ref.held) __atomic_fetch_sub((int32_t *)(ref.actor + 0x1b0), 1, __ATOMIC_SEQ_CST);
+    }
+}
