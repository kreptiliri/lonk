+/* The dice: mostly stalking, sometimes in the way, a gift, a wander or right behind you. */
+static void lonk_roll(void) {
+    unsigned weight[LONK_KINDS] = {25, 15, 15, 15, 15, 0, 0, 15};
+    static int last_kind = -1;
+    if (last_kind == LONK_GIFT) weight[LONK_GIFT] = 0;   /* no two gifts in a row */
+    unsigned total = 0, pick;
+    for (int k = 0; k < LONK_KINDS; k++) total += weight[k];
+    pick = arc4random_uniform(total);
+    int kind = 0;
+    while (pick >= weight[kind]) pick -= weight[kind++];
+    last_kind = kind;
+    lonk_enter(kind, kind == LONK_BEHIND ? 240 + arc4random_uniform(120) : 360 + arc4random_uniform(360));
+}
+/* Ground height near (x, z): the nearest of the player's recent footsteps within 25 m, else the player's own height. */
+static float trail_height(float x, float z, float fallback) {
+    float best = 25 * 25, y = fallback;
+    for (unsigned i = 0; i < trail_count; i++) {
+        float dx = trail[i][0] - x, dz = trail[i][2] - z, d = dx * dx + dz * dz;
+        if (d < best) { best = d; y = trail[i][1]; }
+    }
+    return y;
