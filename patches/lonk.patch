+/* The parts fused on an equipment user's weapon, bow and shield (links 0, 3, 4): actors numbered just after one of those
+   (up to 8 on: when all three are made at once, the parts come after all three, so which goes on which isn't told
+   apart), within 3 m of it (a spear's part sits 2.3 m from its grip), not one of your own pieces (a sheath, a quiver).
+   Up to 4, the number found. */
+static unsigned fuse_parts(uintptr_t eu, uintptr_t out[4], unsigned only) {   /* only: 0..2 = just that one of the three, else all */
+    unsigned n = 0, have_links = 0;
+    uintptr_t links[20];
+    for (unsigned k = 0; eu && k < 3; k++) {
+        if (only < 3 && k != only) continue;
+        uintptr_t w = eu_link_actor(eu, (unsigned[]){0, 3, 4}[k]);
+        float wp[3];
+        if (!w || !read_mem(w + ACTOR_POS, wp, sizeof wp)) continue;
+        uint32_t key = fuse_key(w + 0x390);
+        uintptr_t root = fuse_root(w + 0x390);
+        if (!have_links) for (unsigned l = 0; l < 20; l++) links[l] = eu_link_actor(eu, l);
+        have_links = 1;
+        for (uint32_t d = 1; d <= 8 && n < 4; d++) {
+            uintptr_t part = fuse_find(root, key + d);
+            float pp[3];
+            char name[64];
+            if (!part || !read_mem(part + ACTOR_POS, pp, sizeof pp) || !valid_xyz(pp) ||
+                hypotf(hypotf(pp[0] - wp[0], pp[1] - wp[1]), pp[2] - wp[2]) > 3 || !actor_name_at(part, name)) continue;
+            int skip = part == read_ptr(eu + 0x18);
+            for (unsigned l = 0; l < 20; l++) skip |= links[l] == part;
+            for (unsigned i = 0; i < n; i++) skip |= out[i] == part;
+            if (!skip) out[n++] = part;
+        }
+    }
+    return n;
+}
+static uintptr_t anim_state(uintptr_t actor);
+/* One bool on an actor's animation blackboard, by name, read only (-1: none). The way the game's set-by-name (vtable +0xb0,
+   0x29393e0) finds it: r = [bb+0xd0], resource [r+0x10]; the bools' table [res+0x20]: count u16 +0x18, first u16 +0x1a,
+   name offsets u32 (low 24 bits) from +0x30; names at [res+8] + i32 [[res+8]+0x24]; values: bytes at [bb+0x28]+4. In
+   Link's own tree "IsAttachedWeapon" is "the weapon in hand is fused" (it picks the _Build clips), "IsAttachedShield" too. */
+static int bb_bool(uintptr_t actor, const char *name) {
+    uintptr_t as = anim_state(actor), bb = as ? read_ptr(as + 0x40) : 0, r = bb ? read_ptr(bb + 0xd0) : 0, res = r ? read_ptr(r + 0x10) : 0;
+    uintptr_t desc = res ? read_ptr(res + 0x20) : 0, base = res ? read_ptr(res + 8) : 0, vals = bb ? read_ptr(bb + 0x28) : 0;
+    int32_t pool_off = 0;
+    uint16_t count = 0, first = 0;
+    if (!desc || !base || !vals || !read_mem(base + 0x24, &pool_off, 4) || !read_mem(desc + 0x18, &count, 2) || !read_mem(desc + 0x1a, &first, 2)) return -1;
+    size_t len = strlen(name) + 1;
+    for (uint32_t i = 0; i < count && i < 512; i++) {
+        uint32_t so = 0;
+        char text[64] = {0};
+        if (!read_mem(desc + ((uintptr_t)first + i) * 4 + 0x30, &so, 4) || !read_mem(base + (uintptr_t)(intptr_t)pool_off + (so & 0xffffff), text, len < sizeof text ? len : sizeof text - 1)) continue;
+        if (strcmp(text, name)) continue;
+        uint32_t n = 0;
+        uint8_t v = 0;
+        return read_mem(vals, &n, 4) && i < n && read_mem(vals + 4 + i, &v, 1) ? v : -1;
+    }
+    return -1;
+}
