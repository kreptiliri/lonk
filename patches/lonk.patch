+   same words for every real node, and no veneer. Only with TOTK_SURVEY=1 (test profile), Mac only. */
+static void survey_patch_null_link_count(Module *m) {
+#if TARGET_OS_IPHONE
+    (void)m;
+#else
+    enum { SITE = 0x2b05778 };
+    static const uint32_t original[8] = {0xaa0003e8,   /* mov x8, x0 */
+                                         0xb940f42b,   /* ldr w11, [x1, #0xf4]: faults when the node is null */
+                                         0x2a1f03e0,   /* mov w0, wzr */
+                                         0xb9402109,   /* ldr w9, [x8, #0x20] */
+                                         0x12b0000a,   /* mov w10, #0x7fffffff */
+                                         0xf9401508,   /* ldr x8, [x8, #0x28] */
+                                         0x6b0a017f,   /* cmp w11, w10 (the loop's branch target, kept at +0x18) */
+                                         0x54000140};  /* b.eq +0x2b057bc (ret) */
+    static const uint32_t patched[8] = {0xb9402009,    /* ldr w9, [x0, #0x20] */
+                                        0xf9401408,    /* ldr x8, [x0, #0x28] */
+                                        0x2a1f03e0,    /* mov w0, wzr */
+                                        0xb40001c1,    /* cbz x1, +0x2b057bc: no node, 0 links */
+                                        0xb940f42b,    /* ldr w11, [x1, #0xf4] */
+                                        0x12b0000a,    /* mov w10, #0x7fffffff */
+                                        0x6b0a017f,    /* cmp w11, w10 */
+                                        0x54000140};   /* b.eq +0x2b057bc */
+    if (SITE + sizeof patched <= m->text_end && !memcmp(m->base + SITE, patched, sizeof patched)) return;   /* already on (a reload) */
+    if (SITE + sizeof original > m->text_end || memcmp(m->base + SITE, original, sizeof original)) {
+        fprintf(stderr, "[survey] link-count guard off: main+%#x does not match\n", (unsigned)SITE);
+        return;
+    }
+    memcpy(m->base + SITE, patched, sizeof patched);
+    fprintf(stderr, "[survey] link-count guard: main+%#x counts 0 links for a null node (spawned mannequins have no ForSale link)\n", (unsigned)SITE);
+#endif
+}
