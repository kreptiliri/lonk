+            survey_force((void *)actor, matrix, 0);
+        }
+        fprintf(stderr, "[survey] drop: %s (%#llx) live=%d hidden=%d\n", stalkers[i].name, (unsigned long long)actor, live, model != 0);
+        stalkers[i] = stalkers[--stalker_count];
+        dropped++;
+    }
+    if (!dropped) fprintf(stderr, "[survey] drop: nothing named %s*\n", drop_request);
+    if (!stalker_count) lonk_anchored = 0;
+}
+/* Dressing PouchPlayer the way the pause menu's OneShotChangeEquipmentForPouch does: eu = 0xcbffa0(actor) (its EquipmentUser,
+   [[actor+0x228]+0x230]), then equip 0x1b6cd78(eu, slot, &name, dye -1, 0, 0) per slot. An empty name dresses like the player
+   (or hair + default clothes when the player wears none). The real Player gets its Zonai arm the same way: slot 19 (Extra),
+   "PlayerRaulHand". The pieces spawn asynchronously; isAllCreated 0x1b7be9c(eu) turns nonzero when they're all in. */
+static uintptr_t pouch_eu(uintptr_t actor) {
+    static const uint32_t w_eu[] = {0xf9411408, 0xb4000068, 0xf9411900, 0xd65f03c0};
+    uintptr_t (*get_eu)(uintptr_t) = (uintptr_t (*)(uintptr_t))game_fn(0xcbffa0, w_eu, 4);
+    return get_eu ? get_eu(actor) : 0;
+}
+static unsigned dress_show(uintptr_t eu, uintptr_t world, bool quiet);
+static void dress_log(const char *when, uintptr_t player) {
+    static const uint32_t w_done[] = {0x52887508, 0x8b080008, 0xb9400109, 0x7100053f, 0x54000500, 0xb9400909};
+    uint32_t (*all_created)(uintptr_t) = (uint32_t (*)(uintptr_t))game_fn(0x1b7be9c, w_done, 6);
+    for (unsigned i = 0; i < stalker_count; i++) {
+        if (strcmp(stalkers[i].name, "PouchPlayer")) continue;
+        uintptr_t eu = pouch_eu(stalkers[i].actor);
+        if (!eu) { fprintf(stderr, "[survey] dress %s: no equipment user\n", when); continue; }
+        uint32_t state[20] = {0};
+        for (unsigned s = 0; s < 20; s++) read_mem(eu + 0x43a8 + s * 8, &state[s], 4);
+        uint64_t link[3][3] = {{0}};
+        for (unsigned s = 9; s < 12; s++) read_mem(eu + 0xe0 + (s - 9) * 0x18, link[s - 9], 0x18);
+        fprintf(stderr, "[survey] dress %s: eu=%#llx all_created=%u creating 9/10/11/19=%u/%u/%u/%u links 9=%llx,%llx 10=%llx,%llx 11=%llx,%llx\n", when,
+                (unsigned long long)eu, all_created ? all_created(eu) : 0xffffffffu, state[9], state[10], state[11], state[19],
+                (unsigned long long)link[0][1], (unsigned long long)link[0][2], (unsigned long long)link[1][1], (unsigned long long)link[1][2],
+                (unsigned long long)link[2][1], (unsigned long long)link[2][2]);
+        if (all_created && all_created(eu)) {   /* again every check: a piece's model can arrive after the piece (real armor loads first) */
+            static const uint32_t w_model[] = {0xf9411408, 0xb4000168, 0xf9400500, 0xb4000100, 0xf9400008};
+            uintptr_t (*get_model)(uintptr_t) = (uintptr_t (*)(uintptr_t))game_fn(0xba8854, w_model, 5);
+            uintptr_t world_model = get_model ? get_model(player) : 0;
+            dress_show(eu, world_model ? read_ptr(world_model + 0x60) : 0, false);
+        }
+    }
+}
+/* Every frame once he's dressed: the game keeps putting his pieces back in the menu's scene (that's the flashing, then no legs), so they
+   go back to the world scene each frame. Logs how often that was needed every 10 s. */
+static unsigned fuse_show(uintptr_t eu, uintptr_t world, bool quiet);
+static void fuse_orphans_hide(uintptr_t eu, uintptr_t world);
+static unsigned fuse_parts(uintptr_t eu, uintptr_t out[4], unsigned only);
+static unsigned fuse_hide_left;   /* out of twins: his weapons hide, so their fused parts go to the menu's scene too, a few times over 2 s */
+static void fuse_hide_all(uintptr_t eu, uintptr_t world) {
+    static const uint32_t w_model[] = {0xf9411408, 0xb4000168, 0xf9400500, 0xb4000100, 0xf9400008};
+    static const uint32_t w_bind[] = {0xaa0003e8, 0xf9403000, 0xf100001f, 0xfa411004, 0x54000081};
+    uintptr_t (*get_model)(uintptr_t) = (uintptr_t (*)(uintptr_t))game_fn(0xba8854, w_model, 5);
+    void (*bind)(uintptr_t, uintptr_t) = (void (*)(uintptr_t, uintptr_t))game_fn(0x585d58, w_bind, 5);
+    uintptr_t parts[4];
+    unsigned n = fuse_parts(eu, parts, 3);
+    if (!get_model || !bind || !fuse_menu_scene) return;
+    for (unsigned i = 0; i < n; i++) {
+        uintptr_t model = get_model(parts[i]);
+        if (!model || read_ptr(model + 0x60) != world) continue;
+        char text[64] = "?";
+        actor_name_at(parts[i], text);
+        bind(model, fuse_menu_scene);
+        fprintf(stderr, "[survey] fuse: %s hidden with his weapons\n", text);
+    }
+}
+static void dress_keep(uintptr_t player) {
+    static const uint32_t w_done[] = {0x52887508, 0x8b080008, 0xb9400109, 0x7100053f, 0x54000500, 0xb9400909};
+    static const uint32_t w_model[] = {0xf9411408, 0xb4000168, 0xf9400500, 0xb4000100, 0xf9400008};
+    static unsigned frames, moved;
+    uint32_t (*all_created)(uintptr_t) = (uint32_t (*)(uintptr_t))game_fn(0x1b7be9c, w_done, 6);
+    uintptr_t (*get_model)(uintptr_t) = (uintptr_t (*)(uintptr_t))game_fn(0xba8854, w_model, 5);
+    if (!all_created || !get_model) return;
+    uintptr_t world_model = get_model(player), world = world_model ? read_ptr(world_model + 0x60) : 0;
+    for (unsigned i = 0; i < stalker_count; i++) {
+        if (strcmp(stalkers[i].name, "PouchPlayer")) continue;
+        uintptr_t eu = pouch_eu(stalkers[i].actor);
+        if (eu && world && all_created(eu)) moved += dress_show(eu, world, true);
+        if (eu && world && lonk_twin) moved += fuse_show(eu, world, true);   /* (each new part logged once) */
+        if (eu && world) fuse_orphans_hide(eu, world);
+        if (eu && world && !lonk_twin && fuse_hide_left && (fuse_hide_left = tick_down(fuse_hide_left)) % 30 == 0) fuse_hide_all(eu, world);
+    }
+    if (++frames == 600) { fprintf(stderr, "[survey] dress keep: %u pieces moved back to the world in 600 frames\n", moved); frames = moved = 0; }
+}
+/* The pieces the equipment user made sit in ActorLinks from eu+0x20, 0x18 apart: weapon 0, bow 3, shield 4, head 8, upper 9,
+   lower 10, sheath 11, quiver 14, the arm 18 (found with "survey peek euscan"); slot s of the armor is at eu+0xe0+(s-9)*0x18. get 0x1afbe4(link) returns
+   {actor, holds a reference} through x8 (the reference is a count at actor+0x1b0, dropped the way 0x1b6cd78 drops it).
+   A pouch user's pieces may be made for the menu's own scene, so each one is bound to the world scene and drawn everywhere,
+   like the body (pouch_show). */
+/* His fused parts (a rock on his sword...). The menu's equip makes his weapon with your fuse material ("Equipment_Attachment"),
+   and the weapon makes the part and holds it on the blade, but the part's model stays in the menu's scene like all his
+   pieces (tested: plain sword, plain shield). It isn't in his equipment user's links, and his weapon doesn't point at it
+   the way yours does (your weapon+0x398). What does: every actor sits in one tree, sorted by a creation number, its node at
+   actor+0x390 = {child, child, parent | bits, key (low 32 bits)}, and a weapon makes its part right after itself (your
+   sword d86c, its rock d86d; his d86f, d870). So: the few actors numbered just after his weapon, near it, stuck in the
+   menu's scene. Read only, a few reads a frame. */
+static int actor_name_at(uintptr_t actor, char out[64]);
+static unsigned fuse_turn;
+static unsigned fuse_show(uintptr_t eu, uintptr_t world, bool quiet) {
+    static const uint32_t w_model[] = {0xf9411408, 0xb4000168, 0xf9400500, 0xb4000100, 0xf9400008};
+    static const uint32_t w_bind[] = {0xaa0003e8, 0xf9403000, 0xf100001f, 0xfa411004, 0x54000081};
+    static const uint32_t w_mask[] = {0x79449008, 0xb9401009, 0x6b08013f, 0x1a883128, 0x34000168};
+    uintptr_t (*get_model)(uintptr_t) = (uintptr_t (*)(uintptr_t))game_fn(0xba8854, w_model, 5);
+    void (*bind)(uintptr_t, uintptr_t) = (void (*)(uintptr_t, uintptr_t))game_fn(0x585d58, w_bind, 5);
+    void (*set_mask)(uintptr_t, uint32_t) = (void (*)(uintptr_t, uint32_t))game_fn(0x50138c, w_mask, 5);
+    if (!get_model || !bind || !set_mask || !fuse_menu_scene || !world) return 0;
+    unsigned moved = 0;
+    /* the search is a few thousand small reads (3.0 of his 3.4 ms a frame, measured): every 15 frames, or at once when
+       his weapon, bow or shield changes */
+    static uintptr_t found[3][4], had[3];
+    static unsigned got[3], age;
+    uintptr_t has[3] = {eu_link_actor(eu, 0), eu_link_actor(eu, 3), eu_link_actor(eu, 4)};
+    for (unsigned k = 0; k < 3; k++)
+        if (has[k] != had[k]) { got[k] = fuse_parts(eu, found[k], k); had[k] = has[k]; }
+    if (++age >= 5) { unsigned k = (age = 0, ++fuse_turn % 3); got[k] = fuse_parts(eu, found[k], k); }   /* one of the three every 5 frames */
+    uintptr_t parts[4];
+    unsigned n = 0;
+    for (unsigned k = 0; k < 3; k++)
+        for (unsigned j = 0; j < got[k] && n < 4; j++) {
+            int dup = 0;
+            for (unsigned i = 0; i < n; i++) dup |= parts[i] == found[k][j];
+            if (!dup) parts[n++] = found[k][j];
+        }
+    for (unsigned i = 0; i < n; i++) {
+        uintptr_t model = get_model(parts[i]);
+        if (!model || read_ptr(model + 0x60) != fuse_menu_scene) continue;
+        bind(model, world);
+        set_mask(model, 0xffffffffu);
+        moved++;
+        static uintptr_t told[4];
+        char text[64];
+        if (!quiet || told[i] != parts[i]) { actor_name_at(parts[i], text); fprintf(stderr, "[survey] fuse: %s (fused on his weapons) into the world\n", text); }
+        told[i] = parts[i];
+    }
+    return moved;
+}
+/* Before he re-copies a weapon, bow or shield, the parts fused on his old ones are noted; 1.5 s later any of them still
+   alive (found in the actor tree under its number), not on his new weapons and still drawn in the world goes back to the
+   menu's scene, out of sight: once the old shield's horn stayed on after a re-copy, a second one floating on him (tested). */
+static uintptr_t orphan[4];
+static uint32_t orphan_key[4];
+static unsigned orphan_n, orphan_left;
+static void fuse_orphans_note(uintptr_t eu) {
+    uintptr_t parts[4];
+    unsigned n = fuse_parts(eu, parts, 3);
+    if (orphan_left) return;   /* (a second re-copy before the check: the first list is the old one) */
+    for (unsigned i = 0; i < n; i++) { orphan[i] = parts[i]; orphan_key[i] = fuse_key(parts[i] + 0x390); }
+    orphan_n = n; orphan_left = n ? 90 : 0;
+}
+static void fuse_orphans_hide(uintptr_t eu, uintptr_t world) {
+    static const uint32_t w_model[] = {0xf9411408, 0xb4000168, 0xf9400500, 0xb4000100, 0xf9400008};
+    static const uint32_t w_bind[] = {0xaa0003e8, 0xf9403000, 0xf100001f, 0xfa411004, 0x54000081};
+    if (!orphan_left || --orphan_left) return;
+    uintptr_t (*get_model)(uintptr_t) = (uintptr_t (*)(uintptr_t))game_fn(0xba8854, w_model, 5);
+    void (*bind)(uintptr_t, uintptr_t) = (void (*)(uintptr_t, uintptr_t))game_fn(0x585d58, w_bind, 5);
+    uintptr_t from = 0, now[4];
+    for (unsigned k = 0; k < 3 && !from; k++) from = eu_link_actor(eu, (unsigned[]){0, 3, 4}[k]);
+    unsigned n = fuse_parts(eu, now, 3);
+    if (!get_model || !bind || !fuse_menu_scene || !world || !from) return;
+    for (unsigned i = 0; i < orphan_n; i++) {
+        int still_his = 0;
+        for (unsigned j = 0; j < n; j++) still_his |= now[j] == orphan[i];
+        if (still_his || fuse_lookup(from + 0x390, orphan_key[i]) != orphan[i]) continue;
+        uintptr_t model = get_model(orphan[i]);
+        if (!model || read_ptr(model + 0x60) != world) continue;
+        char text[64] = "?";
+        actor_name_at(orphan[i], text);
+        bind(model, fuse_menu_scene);
+        fprintf(stderr, "[survey] fuse: %s was left over from his old weapon, hidden\n", text);
+    }
+    orphan_n = 0;
+}
+static unsigned dress_show(uintptr_t eu, uintptr_t world, bool quiet) {
+    static const uint32_t w_valid[] = {0xa9bd7bfd, 0xf9000bf5, 0xa9024ff4, 0x910003fd, 0xb9401008};
+    static const uint32_t w_get[] = {0xd10183ff, 0xa9017bfd, 0xf90013f9, 0xa9035ff8, 0xa90457f6};
+    static const uint32_t w_model[] = {0xf9411408, 0xb4000168, 0xf9400500, 0xb4000100, 0xf9400008};
+    static const uint32_t w_bind[] = {0xaa0003e8, 0xf9403000, 0xf100001f, 0xfa411004, 0x54000081};
+    static const uint32_t w_mask[] = {0x79449008, 0xb9401009, 0x6b08013f, 0x1a883128, 0x34000168};
+    typedef struct { uintptr_t actor; uint8_t held, pad[23]; } link_ref;   /* > 16 bytes: returned through x8, as the game does */
+    bool (*valid)(uintptr_t) = (bool (*)(uintptr_t))game_fn(0x1b2f20, w_valid, 5);
+    link_ref (*get)(uintptr_t) = (link_ref (*)(uintptr_t))game_fn(0x1afbe4, w_get, 5);
+    uintptr_t (*get_model)(uintptr_t) = (uintptr_t (*)(uintptr_t))game_fn(0xba8854, w_model, 5);
+    void (*bind)(uintptr_t, uintptr_t) = (void (*)(uintptr_t, uintptr_t))game_fn(0x585d58, w_bind, 5);
+    void (*set_mask)(uintptr_t, uint32_t) = (void (*)(uintptr_t, uint32_t))game_fn(0x50138c, w_mask, 5);
+    if (!valid || !get || !get_model || !bind || !set_mask) { fprintf(stderr, "[survey] dress show: function mismatch\n"); return 0; }
+    unsigned moved = 0;
+    for (int slot = 0; slot < 20; slot++) {   /* every link: weapons, armor, sheath, quiver, the arm (eu+0x20, 0x18 apart, their own order) */
+        uintptr_t link = eu + 0x20 + (uintptr_t)slot * 0x18;
+        if (!valid(link)) continue;
+        link_ref ref = get(link);
+        if (!ref.actor) continue;
+        char text[64] = {0};
+        read_mem(read_ptr(ref.actor + GAME_ACTOR_NAME), text, sizeof text - 1);
+        uintptr_t model = get_model(ref.actor), scene = model ? read_ptr(model + 0x60) : 0;
+        if (model && !lonk_twin && (slot < 8 || (slot >= 11 && slot < 18))) set_mask(model, 0);   /* out of twins: weapons stay hidden */
+        else if (model && world && scene != world) {
+            bind(model, world);
+            set_mask(model, 0xffffffffu);
+            moved++;
+            if (scene) fuse_menu_scene = scene;
+            if (!quiet) fprintf(stderr, "[survey] dress show: link %d %s (%#llx) model=%#llx scene %#llx -> %#llx\n", slot, text, (unsigned long long)ref.actor,
+                    (unsigned long long)model, (unsigned long long)scene, (unsigned long long)world);
+        }
+        if (ref.held) __atomic_fetch_sub((int32_t *)(ref.actor + 0x1b0), 1, __ATOMIC_SEQ_CST);
+    }
+    return moved;
+}
+static void dress_run(void) {
+    static const uint32_t w_equip[] = {0xd10383ff, 0xa9087bfd, 0xa9096ffc, 0xa90a67fa, 0xa90b5ff8, 0xa90c57f6};
+    void (*equip)(uintptr_t, uint32_t, const char **, int32_t, bool, bool) =
+        (void (*)(uintptr_t, uint32_t, const char **, int32_t, bool, bool))game_fn(0x1b6cd78, w_equip, 6);
+    if (!equip) { fprintf(stderr, "[survey] dress: function mismatch\n"); return; }
+    static const char *empty = "", *hand = "PlayerRaulHand", *hair = "Armor_999_Head", *upper = "Armor_Default_Upper", *lower = "Armor_Default_Lower";
+    static char held[64];   /* the game may keep the name pointer */
+    snprintf(held, sizeof held, "%s", dress_name);
+    static const char *one;
+    one = held;
+    for (unsigned i = 0; i < stalker_count; i++) {
+        if (strcmp(stalkers[i].name, "PouchPlayer")) continue;
+        uintptr_t eu = pouch_eu(stalkers[i].actor);
+        if (!eu) { fprintf(stderr, "[survey] dress: PouchPlayer %#llx has no equipment user\n", (unsigned long long)stalkers[i].actor); continue; }
+        if (dress_slot >= 0) {
+            equip(eu, (uint32_t)dress_slot, held[0] ? &one : &empty, held[0] ? dress_dye : -1, 0, 0);
+            fprintf(stderr, "[survey] dress: slot %d <- \"%s\"\n", dress_slot, held);
+        } else {   /* his own look (hair and underwear) by name, an outfit, or twinning: "" is "whatever the player has on" */
+            static char set[3][24];
+            static const char *set_ptr[3];
+            for (int k = 0; k < 3; k++) {
+                snprintf(set[k], sizeof set[k], "Armor_%03d_%s", lonk_outfit, k == 0 ? "Head" : k == 1 ? "Upper" : "Lower");
+                set_ptr[k] = set[k];
+            }
+            equip(eu, 9, lonk_outfit ? &set_ptr[0] : lonk_twin ? &empty : &hair, -1, 0, 0);
+            equip(eu, 10, lonk_outfit ? &set_ptr[1] : lonk_twin ? &empty : &upper, -1, 0, 0);
+            equip(eu, 11, lonk_outfit ? &set_ptr[2] : lonk_twin ? &empty : &lower, -1, 0, 0);
+            if (lonk_outfit) fprintf(stderr, "[survey] dress: %s, %s, %s (and your weapons)\n", set[0], set[1], set[2]);
+            equip(eu, 19, &hand, -1, 0, 0);
+            if (lonk_twin) for (unsigned w = 0; w < 3; w++) equip(eu, (uint32_t[]){0, 7, 8}[w], &empty, -1, 0, 0);   /* and your sword, bow, shield */
+            if (lonk_twin && !lonk_outfit) fprintf(stderr, "[survey] dress: twins (your outfit and weapons), arm %s\n", hand);
+            else if (!lonk_twin) fuse_hide_left = 120;   /* (his weapons hide: their fused parts too) */
+            if (!lonk_twin) fprintf(stderr, "[survey] dress: %s, %s, %s, arm %s\n", hair, upper, lower, hand);
+        }
+        dress_watch = 600;
+    }
+    dress_log("called", 0);
+}
+/* The name of the piece in one link of an equipment user ("" if none; links as in dress_show), through the same calls */
+static void eu_link_name(uintptr_t eu, unsigned index, char out[64]) {
+    static const uint32_t w_valid[] = {0xa9bd7bfd, 0xf9000bf5, 0xa9024ff4, 0x910003fd, 0xb9401008};
+    static const uint32_t w_get[] = {0xd10183ff, 0xa9017bfd, 0xf90013f9, 0xa9035ff8, 0xa90457f6};
+    typedef struct { uintptr_t actor; uint8_t held, pad[23]; } link_ref;
+    bool (*valid)(uintptr_t) = (bool (*)(uintptr_t))game_fn(0x1b2f20, w_valid, 5);
+    link_ref (*get)(uintptr_t) = (link_ref (*)(uintptr_t))game_fn(0x1afbe4, w_get, 5);
+    out[0] = 0;
+    uintptr_t link = eu + 0x20 + index * 0x18;
+    if (!eu || !valid || !get || !valid(link)) return;
+    link_ref ref = get(link);
+    if (!ref.actor) return;
+    read_mem(read_ptr(ref.actor + GAME_ACTOR_NAME), out, 63);
+    out[63] = 0;
+    if (ref.held) __atomic_fetch_sub((int32_t *)(ref.actor + 0x1b0), 1, __ATOMIC_SEQ_CST);
+}
+/* "survey peek euscan": every ActorLink-looking spot in his equipment user (a heap pointer at +8) that resolves to an actor */
+static void eu_scan(uintptr_t eu) {
+    static const uint32_t w_valid[] = {0xa9bd7bfd, 0xf9000bf5, 0xa9024ff4, 0x910003fd, 0xb9401008};
+    static const uint32_t w_get[] = {0xd10183ff, 0xa9017bfd, 0xf90013f9, 0xa9035ff8, 0xa90457f6};
+    typedef struct { uintptr_t actor; uint8_t held, pad[23]; } link_ref;
+    bool (*valid)(uintptr_t) = (bool (*)(uintptr_t))game_fn(0x1b2f20, w_valid, 5);
+    link_ref (*get)(uintptr_t) = (link_ref (*)(uintptr_t))game_fn(0x1afbe4, w_get, 5);
+    if (!eu || !valid || !get) return;
+    for (uintptr_t off = 0; off < 0x4400; off += 8) {
+        uintptr_t q = read_ptr(eu + off + 8), id = read_ptr(eu + off + 0x10);
+        if (q < 0x100000000ull || q > 0x7fffffffffffull || (q & 7) || !id) continue;
+        uint64_t probe;
+        if (!read_mem(q, &probe, 8) || !valid(eu + off)) continue;
+        link_ref ref = get(eu + off);
+        if (!ref.actor) continue;
+        char text[64] = {0};
+        read_mem(read_ptr(ref.actor + GAME_ACTOR_NAME), text, sizeof text - 1);
+        fprintf(stderr, "[survey] euscan: eu+%#llx -> %s\n", (unsigned long long)off, text);
+        if (ref.held) __atomic_fetch_sub((int32_t *)(ref.actor + 0x1b0), 1, __ATOMIC_SEQ_CST);
+    }
+}
+/* "survey peek wscan": what an equipment user's weapon (link 0) and shield (4) point at, looking for the fused part: actor
+   pointers and ActorLinks in the actor and one pointer deeper, by name */
+static int actor_name_at(uintptr_t actor, char out[64]) {
+    uintptr_t np = read_ptr(actor + GAME_ACTOR_NAME);
+    out[0] = 0;
+    if (np < 0x100000000ull || np > 0x7fffffffffffull || !read_mem(np, out, 63)) return 0;
+    out[63] = 0;
+    int k = 0;
+    while (out[k] && (isalnum((unsigned char)out[k]) || out[k] == '_')) k++;
+    return k >= 4 && !out[k];
+}
+static void weapon_scan_area(uintptr_t base, size_t size, uintptr_t self, const char *who, const char *path) {
+    for (uintptr_t off = 0; off + 8 <= size; off += 8) {
+        uintptr_t v = read_ptr(base + off), q = read_ptr(base + off + 8);
+        char text[64];
+        if (v != self && v >= 0x100000000ull && v <= 0x7fffffffffffull && !(v & 7) && actor_name_at(v, text))
+        {
+            float at[3] = {NAN, NAN, NAN};
+            read_mem(v + ACTOR_POS, at, sizeof at);
+            fprintf(stderr, "[survey] wscan %s: %s+%#llx -> actor %s (%#llx) at %.2f,%.2f,%.2f\n", who, path, (unsigned long long)off, text, (unsigned long long)v, at[0], at[1], at[2]);
+        }
