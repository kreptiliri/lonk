+#if defined(TOTK_GAME_V143)
+/* idle, run or dash from his speed (no walk: Camille's call, Link mostly runs or sprints too). The bands overlap by
+   0.3 m/s each side and a new gait has to hold for 12 frames: following you he stops and goes, and every switch restarts
+   the clip, so he did a few steps, snapped back, and went on. */
+static int lonk_move_gait(float v) {
+    static const float edge[3] = {0.4f, 0.4f, 7.3f};   /* idle | (walk, unused) | run | dash */
+    static int g = GAIT_IDLE;
+    static unsigned held;
+    int want = g;
+    while (want < GAIT_DASH && v > edge[want] + 0.3f) want++;
+    while (want > GAIT_IDLE && v < edge[want - 1] - 0.3f) want--;
+    if (want == GAIT_WALK) want = v > edge[0] ? GAIT_RUN : GAIT_IDLE;
+    held = want == g ? 0 : held + 1;
+    if (held >= 12) { g = want; held = 0; }
+    return g;
